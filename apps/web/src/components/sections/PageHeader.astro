---
// Centred label + H1 used by About, Contact, Terms and Blog.
interface Props {
  label: string;
  title: string | string[];
  labelClass?: string;
}
const { label, title, labelClass = 't-caption2' } = Astro.props;
const lines = Array.isArray(title) ? title : [title];
---

<section class="phead">
  <p class={labelClass} data-appear="mount">
    {label}
  </p>
  <h1 class="t-h1 phead__title" data-appear="mount">
    {lines.map((l, i) => (
      <>
        {l}
        {i < lines.length - 1 && <br />}
      </>
    ))}
  </h1>
</section>
<style>
  .phead {
    position: relative;
    z-index: 1;
    background: var(--dx-blanco);
    padding: var(--esp-8) var(--margen);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--esp-2);
  }
  .phead__title {
    text-align: center;
  }
  @media (min-width: 1024px) {
    .phead {
      padding-block: var(--esp-9);
    }
  }
</style>
