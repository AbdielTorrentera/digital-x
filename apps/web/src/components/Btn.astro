---
import Icon from './Icon.astro';

// Botón de la plantilla Marby, tal cual: 28 px de alto, etiqueta en mayúsculas y flecha que gira 45° al pasar el
// cursor (estilos en global.css). Sin `href` se dibuja un <span>, para poder ponerlo dentro de una tarjeta que ya es
// un enlace. La zona de toque es de 48 px aunque se vea de 28 (global.css, .btn::after).
interface Props {
  label?: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'contorno' | 'icon';
  class?: string;
  [key: string]: any;
}
const { label, href, variant = 'primary', class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class:list={['btn', `btn--${variant}`, cls]} {...rest}>
  {variant !== 'icon' && <span class="btn__label">{label}</span>}
  <span class="btn__icon">
    <Icon name="arrow" size="boton" />
  </span>
</Tag>
