import { AcknowledgedWorkflowDeployment } from "@sanity/workflow-engine";
import type { WorkflowDeploymentInput } from "@sanity/workflow-engine";

/**
 * Every config file name a generation root may hold, in the order a loader
 * should look for them. The generated modules import their deployment from
 * whichever one is there, and {@link configModuleSpecifier} turns that name
 * into the specifier they write.
 */
export declare const CONFIG_FILE_NAMES: readonly [
  "sanity.workflow.ts",
  "sanity.workflow.js",
  "sanity.workflow.mjs",
];

/**
 * Declare a Workflows deployment in a `sanity.blueprint.ts` `resources` array.
 * Supply the authored deployment accepted by `defineWorkflowConfig`, including
 * a reviewed `expectedMinReaderModel` acknowledgement.
 *
 * {@link parseWorkflowDeployment} validates the deployment during manifest
 * evaluation. A missing or insufficient acknowledgement, an invalid definition,
 * or an unbound `@<handle>:` alias throws before submission to the Blueprints API.
 *
 * @remarks
 * The Blueprints service must support the `sanity.workflow` resource type before
 * it can deploy the result. Until that support ships, deploy definitions with
 * `npx @sanity/workflow-cli deploy`.
 *
 * Share the authored deployment object with `defineWorkflowConfig`. Its parsed
 * `config.deployments[n]` output may have an unverified or missing acknowledgement
 * and is not accepted as this function's typed input. Export the deployment by
 * its own `name` from `sanity.workflow.ts` as well: the generated resources
 * module and every generated function shell import it from that named export,
 * and the resources module is emitted even for a deployment that needs no
 * functions. The package README's "Declaring the resource" section shows the
 * whole three-file layout.
 *
 * ```ts
 * import {defineBlueprint} from '@sanity/blueprints'
 * import {defineWorkflows} from '@sanity/workflow-blueprint'
 * import {prod} from './shared'
 *
 * export default defineBlueprint({
 *   resources: [defineWorkflows(prod)],
 * })
 * ```
 */
export declare function defineWorkflows(
  deployment: WorkflowDeploymentInput,
  options?: DefineWorkflowsOptions,
): WorkflowsResource;

export declare interface DefineWorkflowsOptions {
  /**
   * Blueprint resource name — the identity blueprints matches deploys on.
   * Defaults to `workflows-<deployment name>` (the deployment's
   * `name` is unique per config; its `tag` may repeat, so a tag-derived
   * default could collide). Keep the name stable after deployment: a retained
   * resource cannot be renamed because removing the old name is rejected.
   */
  name?: string;
  /**
   * Blueprint lifecycle controls. Defaults to `{deletionPolicy: 'retain'}`.
   * Set `deletionPolicy: 'protect'` to reject detach. Set `ownershipAction` to
   * `{type: 'attach', id}` to adopt an existing resource or `{type: 'detach'}`
   * to remove Stack ownership without deleting definitions. Deletion policies
   * that promise deletion (`allow`, `replace`) are rejected.
   */
  lifecycle?: WorkflowsResourceLifecycle;
}

/**
 * Describe a Workflows Blueprint resource as ordered, display-ready data.
 * Pass a `defineWorkflows` result to describe a planned resource. Supply
 * `deployedDefinitions` only when you have an actual deployment or read result;
 * omitting it does not imply that nothing is deployed. Version labels appear
 * only for positive integer versions present in that result.
 *
 * The returned data is plain JSON and contains no terminal formatting. It does
 * not fetch current deployment state.
 */
export declare function describeWorkflowsResource(
  input: WorkflowDisplayInput,
): WorkflowDisplayDetail[];

export declare interface NormalizedWorkflowsResourceLifecycle extends WorkflowsResourceLifecycle {
  deletionPolicy: "retain" | "protect";
}

/**
 * Validate one deployment the way the definition deploy will, so every
 * offline-checkable author error fails here — in the author's terminal at
 * manifest evaluation — rather than as a failed stack operation: the
 * deployment envelope (tag, resource binding, alias bindings) through the
 * config schema, each definition boundary-parsed and validated, definition
 * names checked for batch uniqueness, a dry alias expansion (fail-closed on
 * an unbound `@<handle>:` reference), and the spawn-reference walk that
 * rejects in-set cycles.
 *
 * Returns the parsed deployment (definition document envelopes stripped, so a
 * fetched definition document round-trips cleanly).
 */
export declare function parseWorkflowDeployment(
  input: unknown,
  caller: string,
): AcknowledgedWorkflowDeployment;

/**
 * Parse a Workflows resource lifecycle at an untyped boundary.
 *
 * Missing input defaults to `retain`. Unsupported keys, policies, and dependency
 * values throw an error prefixed with `caller`.
 */
export declare function parseWorkflowLifecycle(
  input: unknown,
  caller: string,
): NormalizedWorkflowsResourceLifecycle;

/**
 * The blueprint resource type string for a Workflows definition deployment.
 */
export declare const WORKFLOW_RESOURCE_TYPE = "sanity.workflow";

/** A labeled scalar, list, or nested group for displaying a Workflows resource. */
export declare type WorkflowDisplayDetail =
  | {
      label: string;
      value: string;
    }
  | {
      label: string;
      values: string[];
    }
  | {
      label: string;
      children: {
        label: string;
        value: string;
      }[];
    };

/** The deployment fields used to describe a planned or deployed Workflows resource. */
export declare interface WorkflowDisplayInput {
  deployment: Pick<
    WorkflowsResource["deployment"],
    "workflowResource" | "tag" | "definitions"
  >;
  /** Omit when deployment results are unavailable. An empty array means no definitions were observed. */
  deployedDefinitions?: readonly {
    name: string;
    version?: number;
  }[];
}

/**
 * A Workflows deployment declared as a Sanity Blueprints resource.
 * Pure data: the blueprint manifest serializes it verbatim into the stack
 * mutation.
 * Blueprints uses `name` as stack identity. A retained resource cannot be
 * renamed in place because the implied removal of the old name is rejected.
 */
export declare interface WorkflowsResource {
  name: string;
  type: typeof WORKFLOW_RESOURCE_TYPE;
  lifecycle: NormalizedWorkflowsResourceLifecycle;
  /** The deployment to provision — the same shape as one `deployments[]`
   *  entry of a `sanity.workflow.ts` config, its floor asserted. Definitions
   *  are carried in authored form; `@<handle>:` aliases expand at provision,
   *  not here. */
  deployment: AcknowledgedWorkflowDeployment;
}

export declare interface WorkflowsResourceLifecycle {
  deletionPolicy?: "retain" | "protect";
  dependsOn?: string;
  ownershipAction?: WorkflowsResourceOwnershipAction;
}

/** A coordinator-owned change to the stack's ownership of a Workflows resource. */
export declare type WorkflowsResourceOwnershipAction =
  | {
      type: "attach";
      id: string;
    }
  | {
      type: "detach";
    };

export {};
