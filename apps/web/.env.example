# Todas opcionales. Sin valores, el build sale limpio.

# "true" carga Vercel Web Analytics y Speed Insights.
PUBLIC_VERCEL_ANALYTICS=

# Lo define Vercel solo. Solo VERCEL_ENV=production se indexa; local y previews salen con noindex y robots.txt bloqueado.
# Para probar el build de producción en local: VERCEL_ENV=production pnpm build
# VERCEL_ENV=
