---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { urlVerServicios } from '../lib/paginas';
---

<Base
  title="Página no encontrada | Digital X"
  description="La página que buscas no existe o cambió de dirección. Vuelve al inicio de Digital X para ver audio, video y tecnología en Puebla."
  noindex
>
  <section class="container nf">
    <p class="t-caption2">Error 404</p>
    <h1 class="t-h1">Esta página no existe</h1>
    <p class="t-body">Al parecer lo que estás buscando se ha movido o no existe.</p>
    <ul class="nf__enlaces">
      <li>
        <Btn label="Ver servicios" href={urlVerServicios} />
      </li>
      <li>
        <Btn label="Regresar al inicio" href="/" variant="secondary" />
      </li>
    </ul>
  </section>
</Base>
<style>
  .nf {
    padding-block: var(--esp-8);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
  }
  .nf__enlaces {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--esp-3);
    width: 100%;
    margin-top: var(--esp-2);
  }
  @media (min-width: 768px) {
    .nf__enlaces {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }
  }
  @media (min-width: 1024px) {
    .nf {
      padding-block: var(--esp-9);
    }
  }
</style>
