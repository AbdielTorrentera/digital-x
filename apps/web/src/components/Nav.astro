---
import Icon from './Icon.astro';
import BotonLlamar from './BotonLlamar.astro';
import { negocio, telUrl } from '../lib/negocio';
import { menu } from '../lib/paginas';

const actual = Astro.url.pathname;
---
<!--
  Móvil (<1024 px): barra con marca, "Llamar" y "Menú". El menú abre a pantalla completa
  con los enlaces pegados abajo (alcance del pulgar) y botones de 56 px.
  Escritorio: barra horizontal; "Servicios" es un desplegable de tres columnas.
  Sin JavaScript el menú queda como lista visible debajo de la barra.
-->
<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__marca" href="/" aria-label={`${negocio.nombre}, ir al inicio`}>{negocio.nombre}</a>

    <div class="menu" id="menu" data-menu>
      <nav class="menu__nav" aria-label="Principal">
        <ul class="menu__lista">
          {menu.map((item) => (
            <li class:list={['menu__item', item.grupos && item.grupos.length > 0 && 'has-sub']}>
              {item.grupos && item.grupos.length > 0 ? (
                <>
                  <button class="menu__enlace menu__sub-btn" type="button" aria-expanded="false" aria-controls="sub-servicios" data-sub-toggle>
                    <span>{item.titulo}</span>
                    <Icon name="plus" size={20} class="menu__mas" />
                  </button>
                  <div class="sub" id="sub-servicios">
                    {item.url && <a class="sub__todos" href={item.url}>Todos los servicios</a>}
                    <div class="sub__grupos">
                      {item.grupos.map((g) => (
                        <div class="sub__grupo">
                          {g.hub ? <a class="sub__titulo" href={g.hub.url}>{g.titulo}</a> : <p class="sub__titulo">{g.titulo}</p>}
                          <ul>
                            {g.servicios.map((s) => (
                              <li><a class="sub__enlace" href={s.url} aria-current={actual === s.url ? 'page' : undefined}>{s.titulo}</a></li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                <a class="menu__enlace" href={item.url} aria-current={actual === item.url ? 'page' : undefined}>{item.titulo}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="menu__movil">
        <a class="menu__btn" href={telUrl}><Icon name="phone" size={20} /> Llamar</a>
        <button class="menu__btn menu__btn--cerrar" type="button" data-menu-close><Icon name="close" size={20} /> Cerrar</button>
      </div>
    </div>

    <div class="nav__acciones">
      <BotonLlamar />
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
        <Icon name="menu" size={20} />
        <span>Menú</span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    /* Por encima del botón de WhatsApp (z 20) para que el menú abierto lo cubra. */
    z-index: 40;
    background: var(--white);
    border-bottom: 1px solid var(--ink-200);
  }
  .nav__bar {
    max-width: var(--container);
    margin-inline: auto;
    padding: 8px 8px 8px var(--gutter);
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .nav__marca {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--h4);
    font-weight: 500;
    line-height: 1;
    color: var(--ink-900);
  }
  .nav__acciones { display: flex; align-items: center; gap: 4px; }
  .nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding-inline: 14px;
    border-radius: 8px;
    background: var(--ink-900);
    color: var(--white);
    font-size: var(--body);
    font-weight: 500;
    line-height: 1;
  }
  :global(html:not(.js)) .nav__toggle { display: none; }

  /* ---------- menú ---------- */
  .menu__lista { display: flex; flex-direction: column; }
  .menu__enlace {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 56px;
    padding: 0 4px;
    font-size: var(--h4);
    font-weight: 500;
    line-height: 1.2;
    text-align: left;
    color: var(--ink-900);
    border-top: 1px solid var(--ink-200);
  }
  .menu__enlace[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  .menu__mas { transition: transform 0.2s var(--ease-inout); }
  .menu__sub-btn[aria-expanded='true'] .menu__mas { transform: rotate(45deg); }

  .sub { padding-bottom: 12px; }
  :global(html.js) .sub:not(.is-open) { display: none; }
  .sub__todos,
  .sub__enlace,
  .sub__titulo {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 4px 0 16px;
    font-size: var(--body);
    color: var(--ink-600);
  }
  .sub__todos { color: var(--ink-900); font-weight: 500; }
  .sub__titulo { color: var(--ink-900); font-weight: 500; }
  .sub__enlace[aria-current='page'] { color: var(--ink-950); text-decoration: underline; text-underline-offset: 4px; }

  .menu__movil { display: none; }

  /* ---------- móvil: panel a pantalla completa ---------- */
  @media (max-width: 1023.98px) {
    .nav__bar { flex-wrap: wrap; }
    .menu { flex: 1 0 100%; order: 3; }
    :global(html.js) .menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 30;
      flex-direction: column;
      gap: 16px;
      padding: 16px 16px max(16px, env(safe-area-inset-bottom));
      background: var(--ink-50);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    /* margin-top:auto pega los enlaces abajo sin perder el scroll cuando el contenido es más alto que la pantalla. */
    :global(html.js) .menu__nav { margin-top: auto; }
    :global(html.js) .menu.is-open { display: flex; animation: menu-in 0.25s var(--ease-appear); }
    /* Llamar y Cerrar quedan siempre a la vista, aunque el panel tenga que hacer scroll. */
    :global(html.js) .menu__movil {
      display: flex;
      gap: 12px;
      position: sticky;
      bottom: calc(-1 * max(16px, env(safe-area-inset-bottom)));
      margin-bottom: calc(-1 * max(16px, env(safe-area-inset-bottom)));
      padding-block: 12px max(16px, env(safe-area-inset-bottom));
      background: var(--ink-50);
    }
    .menu__btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 56px;
      border-radius: 8px;
      background: var(--ink-200);
      color: var(--ink-900);
      font-size: var(--body);
      font-weight: 500;
    }
    .menu__btn--cerrar { background: var(--ink-900); color: var(--white); }
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  /* ---------- escritorio ---------- */
  @media (min-width: 1024px) {
    .nav__bar { min-height: 72px; padding: 8px var(--gutter); gap: 24px; }
    .nav__toggle { display: none; }
    .menu { flex: 1; display: flex; justify-content: center; }
    .menu__lista { flex-direction: row; gap: 4px; }
    .menu__item { position: relative; }
    .menu__enlace {
      width: auto;
      gap: 8px;
      padding: 0 16px;
      border-top: 0;
      border-radius: 8px;
      font-size: var(--body);
      transition: background-color 0.2s ease;
    }
    .menu__enlace:hover,
    .menu__sub-btn[aria-expanded='true'] { background: var(--ink-50); }
    .menu__mas { width: 16px; height: 16px; }
    .sub {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      width: max-content;
      max-width: min(760px, calc(100vw - 2 * var(--gutter)));
      padding: 20px 24px 24px;
      background: var(--white);
      border: 1px solid var(--ink-200);
      border-radius: 12px;
      box-shadow: 0 12px 32px rgba(20, 27, 52, 0.12);
    }
    .sub__grupos { display: grid; grid-template-columns: repeat(3, minmax(190px, 1fr)); gap: 24px; }
    .sub__todos,
    .sub__enlace,
    .sub__titulo { padding: 0 8px; border-radius: 6px; }
    .sub__todos { margin-bottom: 8px; }
    .sub__enlace:hover,
    .sub__todos:hover,
    a.sub__titulo:hover { background: var(--ink-50); color: var(--ink-900); }
  }
</style>
