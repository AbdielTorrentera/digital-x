---
import { site } from '../../lib/site';
const { hero } = await site('home');
---
<section class="hero sobre-negro" data-dark>
  <link rel="preload" as="image" href={hero.poster} fetchpriority="high" />
  <video class="hero__video" data-src={hero.video} poster={hero.poster} muted loop playsinline preload="none" aria-hidden="true"></video>
  <div class="scrim" aria-hidden="true"></div>
  <div class="container hero__inner">
    <h1 class="hero__title" data-appear="mount">{hero.title}</h1>
    <p class="hero__text t-caption2 c-blanco" data-appear="mount">{hero.text}</p>
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: 80vh;
    overflow: clip;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--dx-negro);
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-3);
    padding-bottom: var(--esp-6);
  }
  .hero__title {
    width: 100%;
    font-family: var(--font-titulos);
    font-size: var(--txt-display);
    font-weight: 800;
    line-height: var(--lh-titulo);
    letter-spacing: var(--ls-titulo);
    color: var(--dx-blanco);
  }
  @media (min-width: 1024px) {
    .hero { min-height: 95vh; }
    .hero__inner { align-items: flex-end; }
  }
</style>
