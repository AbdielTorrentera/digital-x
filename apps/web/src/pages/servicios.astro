---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Foto from '../components/Foto.astro';
import TarjetaCategoria from '../components/ui/TarjetaCategoria.astro';
import { hub } from '../content/servicios';
import { collectionPageJsonLd, serializarJsonLd } from '../lib/jsonld';
import { idNegocio, mensajesWhatsApp, negocio, waUrl } from '../lib/negocio';
import { nombresDeServicios } from '../lib/servicios';

// ⚠ FOTOS TEMPORALES (src/assets/temporales/, ver su README). Para poner una real: cambiar el import y el alt.
// El build de producción falla mientras alguna página use una temporal.
import fotoPortada from '../assets/temporales/temporal-salon-escenario-pantalla-bocinas.jpg';
import fotoAudio from '../assets/temporales/temporal-bocinas-colgadas-techo.jpg';
import fotoVideo from '../assets/temporales/temporal-camara-tripode-transmision.jpg';
import fotoTecnologia from '../assets/temporales/temporal-laptop-escritorio-software.jpg';

const portada = {
  src: fotoPortada,
  alt: 'Salón para eventos con escenario, pantalla grande, bocinas y luces, y mesas preparadas',
};
const fotos = {
  audio: { src: fotoAudio, alt: 'Bocinas de sonido profesional colgadas del techo de un recinto, en blanco y negro' },
  video: { src: fotoVideo, alt: 'Cámara de video sobre un trípode grabando una sesión en un salón' },
  tecnologia: { src: fotoTecnologia, alt: 'Laptop abierta sobre un escritorio de madera con código en la pantalla' },
};

const url = new URL('/servicios/', negocio.url).href;
const datosEstructurados = collectionPageJsonLd({
  url,
  nombre: hub.title,
  descripcion: hub.descripcion,
  idNegocio,
  elementos: hub.categorias.map((c) => ({ name: c.titulo, url: new URL(c.url, negocio.url).href })),
});
---

<!-- Estructura: docs/estructura-sitio-digitalx.md sección 5. Metadatos y H1: docs/reglas-seo-digitalx.md sección 1. -->
<Base title={hub.title} description={hub.descripcion} whatsapp={mensajesWhatsApp.general}>
  <section class="phero sobre-negro">
    <Foto class="phero__img" src={portada.src} alt={portada.alt} sizes="100vw" prioritaria />
    <div class="container phero__inner">
      <h1 class="t-h1 c-blanco">{hub.h1}</h1>
    </div>
  </section>
  <section class="plist">
    <div class="container plist__inner">
      <p class="t-body plist__intro">{hub.intro}</p>
      <ul class="plist__grid">
        {hub.categorias.map((c) => (
          <li data-appear>
            <TarjetaCategoria
              titulo={c.titulo}
              contador={c.contador}
              para={c.para}
              servicios={nombresDeServicios(c.categoria)}
              url={c.url}
              boton={c.boton}
              foto={fotos[c.categoria]}
            />
          </li>
        ))}
        <li class="pcontacto sobre-negro" data-appear>
          <h2 class="t-h3 c-blanco">{hub.contacto.titulo}</h2>
          <p class="t-body c-blanco">{hub.contacto.texto}</p>
          <Btn
            label={hub.contacto.boton}
            href={waUrl(hub.contacto.mensaje)}
            target="_blank"
            rel="noopener"
            aria-label={`${hub.contacto.boton} (se abre en una pestaña nueva)`}
          />
        </li>
      </ul>
    </div>
  </section>
  <script type="application/ld+json" set:html={serializarJsonLd(datosEstructurados)} />
</Base>
<style>
  /* La portada de la página de listado de Marby: foto a todo el ancho con el título encima. En lugar de la franja
     de vidrio, la foto se oscurece (--dx-brillo-sobre-foto) para que el texto blanco cumpla el contraste (marca §3).
     El alto es mínimo, no fijo: el título crece con el zoom y la letra grande (diseño §9). */
  .phero {
    position: relative;
    min-height: 280px;
    overflow: clip;
    display: flex;
    align-items: center;
  }
  /* Picture no le pone al <img> el atributo de alcance de Astro: se selecciona como global dentro de la sección. */
  .phero :global(.phero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .phero__inner {
    position: relative;
    padding-block: var(--esp-7);
  }
  .phero__inner h1 {
    max-width: 20ch;
  }

  .plist {
    background: var(--dx-blanco);
    padding-block: var(--esp-8);
  }
  .plist__inner {
    display: flex;
    flex-direction: column;
    gap: var(--esp-7);
  }
  .plist__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--esp-6);
  }
  /* La cuarta celda: el bloque de contacto de la página de listado de Marby, con la única acción principal. */
  .pcontacto {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--esp-4);
    padding: var(--esp-5);
    border-radius: var(--radio);
  }
  @media (min-width: 768px) {
    .phero {
      min-height: 400px;
    }
    .plist__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--medianil);
      row-gap: var(--esp-7);
    }
    /* Con la altura de la foto de su fila, no de toda la tarjeta de al lado. */
    .pcontacto {
      align-self: start;
      aspect-ratio: 4 / 3;
    }
  }
  @media (min-width: 1024px) {
    .plist {
      padding-block: var(--esp-9);
    }
  }
</style>
