---
import Btn from '../Btn.astro';
import Foto from '../Foto.astro';
import { enlaceAPagina } from '../../lib/enlaces';
import type { Parte } from '../../lib/servicios';
import type { Foto as FotoDeContenido } from '../../lib/contenido/inicio';

// Tarjetas de servicio: la sección Services de la plantilla Marby. Tarjetas del mismo alto; cada una se fija arriba
// (position: sticky) y la siguiente se desliza encima. La tarjeta ENTERA lleva a su destino: el título es el enlace y se
// extiende a toda la tarjeta (::after), para no anidar enlaces. Los nombres que van dentro del párrafo van por encima y
// son enlaces solo si traen URL. El botón es un <span> decorativo. Solo cambian los textos, los colores (tokens --dx-*),
// las tipografías y lo que exigen las reglas (aria-label, movimiento reducido). Medidas y animaciones, las del original.
// Es configurable y no sabe de qué son las tarjetas: hoy el Inicio la usa con las categorías (las páginas de categoría
// usan la tarjeta de propiedad, ui/TarjetaServicio.astro).
export interface Tarjeta {
  /** Número de la tarjeta ("/1"). */
  contador: string;
  titulo: string;
  /** A dónde lleva la tarjeta entera. */
  href: string;
  /** Texto accesible del enlace. */
  ariaLabel: string;
  foto: FotoDeContenido;
  /** El párrafo, en trozos: texto suelto y nombres (con enlace si traen URL). */
  parrafo: Parte[];
  /** Texto del botón decorativo ("Ver servicio", "Ver servicios"). */
  boton: string;
}
interface Props {
  /** Encabezado de la sección; sin él, la página ya tiene su H1 y la sección no dibuja encabezado. */
  etiqueta?: string;
  titulo?: string;
  /** Pequeña etiqueta de cada tarjeta. */
  etiquetaTarjeta: string;
  items: Tarjeta[];
  id?: string;
}
const { etiqueta, titulo, etiquetaTarjeta, items, id } = Astro.props;
---

<section class="services" id={id}>
  <div class="container services__inner">
    {(etiqueta || titulo) && (
      <div class="services__head">
        {etiqueta && (
          <p class="t-caption2" data-appear>
            {etiqueta}
          </p>
        )}
        {titulo && (
          <h2 class="t-h2" data-appear style="--appear-delay:0.1s">
            {titulo}
          </h2>
        )}
      </div>
    )}
    <div class="services__stack">
      {items.map((s, i) => (
        <article
          class="svc hover-target"
          data-appear={i === 0 ? '' : undefined}
          style={i === 0 ? '--appear-delay:0.2s;--appear-ease:var(--ease)' : undefined}
        >
          <Foto class="svc__img" src={s.foto.src} alt={s.foto.alt} sizes="(min-width: 810px) 50vw, 100vw" />
          <div class="svc__card">
            <div class="svc__progress">
              <span class="svc__line" />
              <span class="svc__count">{s.contador}</span>
            </div>
            <p class="t-body-sm">{etiquetaTarjeta}</p>
            <h3 class="t-h3">
              <a class="svc__enlace" href={enlaceAPagina(s.href)} aria-label={s.ariaLabel}>
                {s.titulo}
              </a>
            </h3>
            <div class="svc__text">
              <p class="t-body">
                {s.parrafo.map((parte) => {
                  if ('literal' in parte) return parte.literal;
                  return parte.url ? (
                    <a class="svc__nombre" href={enlaceAPagina(parte.url)}>
                      {parte.nombre}
                    </a>
                  ) : (
                    parte.nombre
                  );
                })}
              </p>
            </div>
            <Btn class="svc__boton" label={s.boton} variant="secondary" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .services {
    background: var(--dx-blanco);
    padding-block: 80px;
    /* "Ver servicios" (portada y 404) llega aquí (/#servicios): el header fijo no debe tapar el título. */
    scroll-margin-top: var(--nav-alto);
  }
  .services__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .services__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  /* El espacio entre tarjetas es lo que tarda la siguiente en llegar a montarse sobre la anterior: con 20 px el botón (al
     pie de la tarjeta) se cubría casi al instante de fijarse y no daba tiempo de verlo ni de usarlo. Con casi media pantalla
     (`dvh`), cada tarjeta queda fija y COMPLETA, con su botón a la vista y clicable, durante un buen tramo de scroll antes de
     que la siguiente la cubra. */
  .services__stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
    gap: clamp(20px, 45vh, 480px);
    gap: clamp(20px, 45dvh, 480px);
  }
  .svc {
    position: sticky;
    top: 100px;
    height: 500px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  /* <picture> no pinta caja: así el <img> es el elemento flexible, como en el original. Y Picture no le pone al <img> el
     atributo de alcance de Astro, por eso se selecciona como global dentro de la sección. */
  .svc :global(picture) {
    display: contents;
  }
  .svc :global(.svc__img) {
    flex: 1 1 0;
    min-width: 0;
    height: 500px;
    object-fit: cover;
    border-radius: 8px;
  }
  /* El título es el único enlace de la tarjeta y se extiende a toda ella. Los nombres de servicio (enlaces) van por
     encima. .svc es sticky, así que es el bloque de referencia del ::after. */
  .svc__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  /* El botón es decorativo (un <span>): el enlace extendido del título ocupa toda la tarjeta y queda por debajo de él, así
     que sin esto el clic sobre el botón no llegaba al enlace. Con `pointer-events: none` el clic lo atraviesa y llega al
     enlace de SU propia tarjeta. */
  .svc :global(.svc__boton) {
    pointer-events: none;
  }
  .svc__nombre {
    position: relative;
    z-index: 1;
    text-decoration: underline;
    text-underline-offset: var(--esp-1);
  }
  .svc__card {
    flex: 1 1 0;
    min-width: 0;
    height: 500px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px;
    border-radius: 8px;
    background: var(--dx-gris-tarjeta);
    overflow: hidden;
  }
  .svc__progress {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 9px;
  }
  .svc__line {
    width: 100%;
    height: 1px;
    background: var(--dx-gris-medio);
  }
  .svc__count {
    font-family: var(--font-texto);
    font-size: 14px;
    line-height: 1.2;
    color: var(--dx-negro);
  }
  .svc__text {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
  }
  @media (max-width: 1199.98px) {
    .services {
      padding-block: 40px;
    }
    .services__inner {
      gap: 20px;
    }
  }
  @media (max-width: 809.98px) {
    .services__inner {
      gap: 40px;
    }
    .svc {
      height: auto;
      flex-direction: column;
    }
    .svc:nth-child(3) {
      top: 120px;
    }
    .svc :global(.svc__img),
    .svc__card {
      flex: none;
      width: 100%;
    }
    /* La tarjeta entera (foto + texto) debe caber en la pantalla junto con su top fijo: la foto se adapta al alto. */
    .svc :global(.svc__img) {
      height: clamp(120px, 24dvh, 260px);
    }
    .svc__card {
      height: auto;
      gap: var(--esp-2);
    }
    /* Sin alto fijo ni texto centrado: el párrafo queda pegado al título y el botón justo después. */
    .svc__text {
      flex: none;
      height: auto;
      align-items: flex-start;
    }
  }
  /* Movimiento reducido (diseño §8): las tarjetas se muestran una debajo de otra, sin que se fijen ni se encimen. */
  @media (prefers-reduced-motion: reduce) {
    .services__stack {
      gap: 20px;
    }
    /* `top` también vuelve a `auto`: en `relative` desplazaría cada tarjeta 100 px hacia abajo y la última invadiría la
       sección siguiente, que taparía su botón. */
    .svc,
    .svc:nth-child(3) {
      position: relative;
      top: auto;
    }
  }
</style>
