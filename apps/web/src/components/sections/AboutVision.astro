---
import Foto from '../Foto.astro';
import type { Foto as FotoDatos } from '../../lib/contenido/inicio';

// Manifiesto sobre foto oscura: AboutVision de la plantilla Marby (Vision & Mission), con 3 tarjetas en lugar de 2
// (se alternan los dos desfases). Cambian los textos, los colores (tokens --dx-*), las tipografías y el brillo de la
// foto (--dx-brillo-sobre-foto), para que el texto blanco cumpla contraste. Medidas y animaciones, las de la plantilla.
interface Item {
  titulo: string;
  texto: string;
}
interface Props {
  etiqueta?: string;
  titulo: string;
  texto?: string;
  foto: FotoDatos;
  items: Item[];
}
const { etiqueta, titulo, texto, foto, items } = Astro.props;
---

<section class="vision sobre-negro" data-appear="mount" style="--appear-delay:0.6s">
  <Foto class="vision__bg" src={foto.src} alt="" sizes="100vw" />
  <div class="container vision__inner">
    <div class="vision__head">
      <div class="vision__title">
        {etiqueta && <p class="t-caption2 c-blanco">{etiqueta}</p>}
        <h2 class="t-h2 c-blanco">{titulo}</h2>
      </div>
      {texto && <p class="t-body c-blanco balance vision__text">{texto}</p>}
    </div>
    <ul class="vision__cards">
      {items.map((c, i) => (
        <li class:list={['vision__box', i % 2 === 0 ? 'vision__box--a' : 'vision__box--b']}>
          <div class="vcard">
            <h3 class="t-h3 c-blanco">{c.titulo}</h3>
            <div class="vcard__text">
              <p class="t-body c-blanco">{c.texto}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .vision {
    position: relative;
    height: 700px;
    padding-block: 80px;
    overflow: clip;
    display: flex;
    align-items: center;
  }
  .vision :global(.vision__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .vision__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .vision__head {
    display: flex;
    align-items: flex-end;
    gap: 20px;
  }
  .vision__title {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .vision__title h2 {
    max-width: 460px;
  }
  .vision__text {
    width: 460px;
  }
  .vision__cards {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .vision__box {
    flex: 1 1 0;
    min-width: 0;
    overflow: clip;
  }
  .vision__box--a {
    padding: 80px 20px 0 0;
  }
  .vision__box--b {
    padding: 0 0 80px 20px;
  }
  .vcard {
    width: 535px;
    max-width: 100%;
    height: 248px;
    padding: 20px;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--dx-negro) 15%, transparent);
    box-shadow: inset 0 0 0 1px var(--dx-linea-sobre-foto);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  /* El texto va justo debajo del título (no al fondo de la tarjeta); el alto y los desfases no cambian. */
  .vcard__text {
    margin-top: var(--esp-2);
  }
  @media (max-width: 1199.98px) {
    .vcard {
      width: 100%;
    }
  }
  @media (max-width: 809.98px) {
    .vision {
      height: auto;
    }
    .vision__head,
    .vision__cards {
      flex-direction: column;
      align-items: stretch;
    }
    .vision__text {
      width: 100%;
    }
    .vision__cards {
      gap: 0;
    }
    .vision__box {
      flex: none;
    }
    .vision__box--a {
      padding: 0 20px 40px 0;
    }
    .vision__box--b {
      padding: 0 0 40px 20px;
    }
  }
</style>
