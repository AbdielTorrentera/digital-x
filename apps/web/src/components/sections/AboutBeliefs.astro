---
import Foto from '../Foto.astro';
import type { Foto as FotoDatos } from '../../content/inicio';

// Lista numerada con foto fija: AboutBeliefs de la plantilla Marby ("what we believe"). Solo cambian los textos, los
// colores (tokens --dx-*) y las tipografías. Medidas, tarjetas apiladas en móvil y animaciones, las de la plantilla.
interface Item {
  titulo: string;
  texto: string;
}
interface Props {
  etiqueta?: string;
  titulo: string;
  foto: FotoDatos;
  items: Item[];
}
const { etiqueta, titulo, foto, items } = Astro.props;
---

<section class="beliefs">
  <div class="beliefs__inner">
    <div class="beliefs__head">
      {etiqueta && (
        <p class="t-caption2" data-appear>
          {etiqueta}
        </p>
      )}
      <h2 class="t-h2" data-appear style="--appear-delay:0.1s">
        {titulo}
      </h2>
    </div>
    <div class="beliefs__body" data-appear style="--appear-delay:0.2s">
      <div class="beliefs__sticky">
        <Foto class="beliefs__img" src={foto.src} alt={foto.alt} sizes="(min-width: 1200px) 40vw, 100vw" />
      </div>
      <ol class="beliefs__cards">
        {items.map((b, i) => (
          <li class="scard">
            <p class="t-caption">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="t-h4">{b.titulo}</h3>
            <div class="scard__text">
              <p class="t-body">{b.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .beliefs {
    background: var(--dx-blanco);
    padding: 80px 20px;
  }
  .beliefs__inner {
    max-width: 1240px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .beliefs__head {
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .beliefs__body {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .beliefs__sticky {
    flex: 1 1 0;
    min-width: 0;
    height: 500px;
    position: sticky;
    top: 120px;
    overflow: hidden;
  }
  /* <picture> no pinta caja; Picture no le pone al <img> el atributo de alcance de Astro (se usa :global). */
  .beliefs__sticky :global(picture) {
    display: contents;
  }
  .beliefs__sticky :global(.beliefs__img) {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: 8px;
  }
  .beliefs__cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .scard {
    width: 460px;
    height: 500px;
    padding: 20px;
    border-radius: 8px;
    background: var(--dx-gris-claro);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  /* El texto va justo debajo del título (no al fondo de la tarjeta): se lee antes de que la siguiente se encime. */
  .scard__text {
    margin-top: var(--esp-2);
  }
  @media (max-width: 1199.98px) {
    .beliefs {
      padding-block: 40px;
    }
    .beliefs__cards {
      flex: 1 1 0;
      min-width: 0;
    }
    .scard {
      width: 100%;
    }
  }
  @media (max-width: 809.98px) {
    .beliefs__body {
      flex-direction: column;
      align-items: stretch;
    }
    .beliefs__sticky {
      position: relative;
      top: auto;
      flex: none;
    }
    .beliefs__cards {
      overflow: clip;
    }
    .scard {
      position: sticky;
    }
    .scard:nth-child(1) {
      top: 100px;
    }
    .scard:nth-child(2) {
      top: 105px;
    }
    .scard:nth-child(3) {
      top: 110px;
    }
  }
  /* Movimiento reducido (diseño §8): las tarjetas se muestran una debajo de otra, sin fijarse ni encimarse. */
  @media (prefers-reduced-motion: reduce) {
    .scard {
      position: static;
    }
  }
</style>
