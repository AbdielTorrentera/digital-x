---
import menu from '../icons/menu.svg?raw';
import arrow from '../icons/arrow.svg?raw';
import check from '../icons/check.svg?raw';
import plus from '../icons/plus.svg?raw';
import pin from '../icons/pin.svg?raw';
import search from '../icons/search.svg?raw';
import whatsapp from '../icons/whatsapp.svg?raw';
import phone from '../icons/phone.svg?raw';

const close =
  '<svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/></svg>';
const icons = { menu, arrow, check, plus, pin, search, close, whatsapp, phone };

// Tamaños de diseño §6: 'base' (24 px) y 'boton' (20 px, dentro de botones). Salen de tokens.css.
interface Props { name: keyof typeof icons; size?: 'base' | 'boton'; class?: string }
const { name, size = 'base', class: cls } = Astro.props;
const svg = icons[name].replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<span class:list={['icon', `icon--${size}`, cls]} set:html={svg} />
<style>
  .icon { display: inline-grid; place-items: center; flex: none; width: var(--icono); height: var(--icono); line-height: 0; }
  .icon--boton { width: var(--icono-boton); height: var(--icono-boton); }
  .icon :global(svg) { width: 100%; height: 100%; }
</style>
