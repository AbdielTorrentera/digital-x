---
// Íconos: Phosphor Icons (MIT, licencia en src/icons/LICENSE-PHOSPHOR), peso Regular en todos, salvo el teléfono del botón
// flotante de llamada, que va en Bold para igualar el peso del logo de WhatsApp. Única excepción de fuente: el logo de
// WhatsApp es el glifo oficial de la marca de Simple Icons (CC0, src/icons/LICENSE-SIMPLE-ICONS). Copiados como SVG (sin
// paquete, CDN ni fuente de íconos), con `currentColor`.
import menu from '../icons/list.svg?raw';
import arrow from '../icons/arrow-up-right.svg?raw';
import check from '../icons/check.svg?raw';
import plus from '../icons/plus.svg?raw';
import pin from '../icons/map-pin.svg?raw';
import close from '../icons/x.svg?raw';
import whatsapp from '../icons/whatsapp-simple-icons.svg?raw';
import phone from '../icons/phone-bold.svg?raw';

const icons = { menu, arrow, check, plus, pin, close, whatsapp, phone };

// Tamaños de diseño §6: 'base' (24 px), 'boton' (20 px, dentro de botones) y 'flotante' (botones flotantes). Salen de tokens.css.
interface Props {
  name: keyof typeof icons;
  size?: 'base' | 'boton' | 'flotante';
  class?: string;
}
const { name, size = 'base', class: cls } = Astro.props;
const svg = icons[name].replace('<svg', '<svg aria-hidden="true" focusable="false"');
---

<span class:list={['icon', `icon--${size}`, cls]} set:html={svg} />
<style>
  .icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--icono);
    height: var(--icono);
    line-height: 0;
  }
  .icon--boton {
    width: var(--icono-boton);
    height: var(--icono-boton);
  }
  .icon--flotante {
    width: var(--icono-flotante);
    height: var(--icono-flotante);
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
