{
  "name": "@sanity-labs/groq-wasm",
  "version": "1.0.2",
  "description": "WASM bindings for GROQ linting and formatting (groq-lint + groq-format)",
  "keywords": [
    "sanity",
    "groq",
    "lint",
    "format",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "author": "Sanity.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanity-labs/sanity-lint.git",
    "directory": "packages/groq-wasm"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm"
  ],
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3",
    "@sanity-labs/lint-core": "1.0.0"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:wasm": "./scripts/build-wasm.sh",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}