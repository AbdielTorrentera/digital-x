---
import Btn from '../Btn.astro';
import Foto from '../Foto.astro';
import type { Imagen } from '../../lib/contenido/tipos';

// Cierre de la página (Nosotros, las categorías y la página de cada servicio): el bloque de contacto del pie de la
// plantilla Marby (foto oscura con velo), SIN formulario. Una sola columna centrada: título, texto y, debajo, dos botones
// lado a lado. WhatsApp es el principal (el único con relleno amarillo); Llamar es secundario, de contorno blanco, del
// mismo alto y tipografía, para que se vean como pareja sin restarle protagonismo al principal. En pantallas angostas se
// apilan si no caben. El número de teléfono no se muestra aquí (vive en el pie): el botón lo lleva en su aria-label.
// Distinto del llamado final blanco del Inicio. Cambian los textos, los colores (tokens --dx-*), las tipografías y el velo,
// más oscuro para que el texto blanco cumpla contraste. Medidas y animaciones, las de la plantilla.
interface Props {
  /** Foto de fondo (decorativa). */
  foto: Imagen;
  titulo: string;
  texto: string;
  whatsapp: { etiqueta: string; href: string };
  /** `numero` solo se usa en el aria-label del botón; no se muestra. */
  llamar: { etiqueta: string; href: string; numero: string };
}
const { foto, titulo, texto, whatsapp, llamar } = Astro.props;
---

<section class="contact sobre-negro">
  <Foto class="contact__bg" src={foto} alt="" sizes="100vw" />
  <div class="contact__scrim" aria-hidden="true"></div>
  <div class="container contact__inner">
    <h2 class="t-h2 c-blanco contact__title" data-appear>
      {titulo}
    </h2>
    <p class="t-body c-blanco contact__text balance" data-appear style="--appear-delay:0.1s">
      {texto}
    </p>
    <div class="contact__botones" data-appear style="--appear-delay:0.2s">
      <Btn
        label={whatsapp.etiqueta}
        href={whatsapp.href}
        target="_blank"
        rel="noopener"
        aria-label={`${whatsapp.etiqueta} (se abre en una pestaña nueva)`}
      />
      <Btn
        label={llamar.etiqueta}
        href={llamar.href}
        variant="contorno"
        aria-label={`${llamar.etiqueta} a Digital X: ${llamar.numero}`}
      />
    </div>
  </div>
</section>
<style>
  .contact {
    position: relative;
    min-height: 752px;
    padding-block: 80px;
    display: flex;
    align-items: center;
    overflow: clip;
  }
  .contact :global(.contact__bg) {
    position: absolute;
    inset: -116px -122px;
    width: calc(100% + 244px);
    height: calc(100% + 232px);
    max-width: none;
    object-fit: cover;
  }
  .contact__scrim {
    position: absolute;
    inset: 0;
    background: var(--dx-capa-oscura);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
  /* Una sola columna centrada; el texto no se estira en pantallas grandes (~60 caracteres). */
  .contact__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .contact__title {
    max-width: 20ch;
  }
  .contact__text {
    max-width: 60ch;
  }
  /* Dos botones lado a lado; en pantallas angostas pasan uno debajo del otro. */
  .contact__botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
    padding-top: 20px;
  }
</style>
