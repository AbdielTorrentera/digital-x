---
import Logo from './Logo.astro';
import { negocio, telUrl, waUrl } from '../lib/negocio';
import { categoriasDeServicios, enlacesEmpresa, enlacesLegales } from '../lib/paginas';

// Pie de página (estructura sección 4, reglas-seo sección 4).
// Las columnas de servicios y de la empresa enlazan páginas planeadas (como el menú); las redes, solo con URL real.
// Los enlaces legales van en la línea inferior, junto al ©.
// El texto de cobertura es fijo, en texto plano y sin enlaces por ciudad.
const anio = new Date().getFullYear();
---

<footer class="footer sobre-negro">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__marca">
        <a class="footer__logo" href="/">
          <Logo />
        </a>
        <p class="t-body footer__cobertura">{negocio.textoCobertura}</p>
      </div>

      <div class="footer__cols">
        {categoriasDeServicios.length > 0 && (
          <div class="footer__col">
            <p class="footer__titulo">Servicios</p>
            <ul>
              {categoriasDeServicios.map((c) => (
                <li>
                  <a class="footer__enlace" href={c.url}>
                    {c.titulo}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {enlacesEmpresa.length > 0 && (
          <div class="footer__col">
            <p class="footer__titulo">{negocio.nombre}</p>
            <ul>
              {enlacesEmpresa.map((p) => (
                <li>
                  <a class="footer__enlace" href={p.url}>
                    {p.titulo}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="footer__col">
          <p class="footer__titulo">Contacto</p>
          <ul>
            <li>
              <a class="footer__enlace" href={telUrl}>
                {negocio.telefono.pantalla}
              </a>
            </li>
            <li>
              <a class="footer__enlace" href={waUrl()} target="_blank" rel="noopener">
                Escríbenos por WhatsApp
              </a>
            </li>
            {negocio.correo && (
              <li>
                <a class="footer__enlace" href={`mailto:${negocio.correo}`}>
                  {negocio.correo}
                </a>
              </li>
            )}
            {negocio.redes.map((r) => (
              <li>
                <a class="footer__enlace" href={r.url} target="_blank" rel="noopener">
                  {r.nombre}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__abajo">
      <p class="t-caption footer__copy">
        © {anio} {negocio.nombre}
      </p>
      <ul class="footer__legales">
        {enlacesLegales.map((p) => (
          <li>
            <a class="footer__legal" href={p.url}>
              {p.titulo}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  /* El relleno inferior deja libre el final de la página para que los botones flotantes no tapen texto: en móvil y
     tableta son dos (llamada 56 px + 8 px + WhatsApp 56 px + margen), en escritorio solo WhatsApp. */
  /* .sobre-negro (tokens.css) pone fondo negro, texto blanco, texto secundario en gris medio y foco amarillo. */
  /* Línea fina de 1 px arriba (gris medio sobre negro): separa el pie del cierre de foto oscura que lo precede, para que
     no queden dos bloques oscuros seguidos sin separación. */
  .footer {
    padding: var(--esp-8) 0 calc(var(--esp-9) + var(--esp-7));
    box-shadow: inset 0 var(--linea) 0 var(--borde);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--esp-6);
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--esp-6);
  }
  .footer__marca {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--tactil);
    color: var(--dx-blanco);
  }
  .footer__cobertura {
    color: var(--texto-sec);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--esp-5);
  }
  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }
  .footer__titulo {
    font-family: var(--font-titulos);
    font-size: var(--txt-cuerpo);
    font-weight: 800;
    line-height: var(--lh-etiqueta);
    color: var(--dx-blanco);
    margin-bottom: var(--esp-2);
  }
  .footer__enlace {
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
    font-size: var(--txt-cuerpo);
    line-height: var(--lh-etiqueta);
    color: var(--dx-blanco);
  }
  .footer__enlace:hover {
    color: var(--dx-amarillo);
  }
  .footer__copy {
    color: var(--texto-sec);
  }
  /* Línea inferior: el © y, como enlaces pequeños (14 px) con 48 px de área táctil, los legales. */
  .footer__abajo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-2);
  }
  .footer__legales {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2) var(--esp-5);
  }
  .footer__legal {
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
    font-size: var(--txt-chico);
    line-height: var(--lh-etiqueta);
    color: var(--dx-blanco);
  }
  .footer__legal:hover {
    color: var(--dx-amarillo);
  }

  @media (min-width: 768px) {
    .footer__abajo {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
    .footer__cols {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--medianil);
    }
  }
  /* Escritorio: retícula de 12 columnas; la marca ocupa 4 y los enlaces 8. */
  @media (min-width: 1024px) {
    .footer {
      padding-top: var(--esp-9);
      padding-bottom: var(--esp-9);
    }
    .footer__top {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: var(--medianil);
    }
    .footer__marca {
      grid-column: span 4;
    }
    .footer__cols {
      grid-column: span 8;
    }
  }
</style>
