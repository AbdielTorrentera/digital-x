---
import Btn from '../Btn.astro';
import { site } from '../../lib/site';
const { services } = await site('home');
---
<section class="services">
  <div class="container services__inner">
    <div class="services__head">
      <p class="t-caption2" data-appear>{services.label}</p>
      <h2 class="t-h2" data-appear>{services.title}</h2>
    </div>
    <div class="services__stack">
      {services.items.map((s: any, i: number) => (
        <a class="svc hover-target" href={s.href} data-appear={i === 0 ? '' : undefined}>
          <img class="svc__img" src={s.image} alt="Service card property image" loading="lazy" />
          <div class="svc__card">
            <div class="svc__progress">
              <span class="svc__line"></span>
              <span class="svc__count">{s.counter}</span>
            </div>
            <p class="t-body c-negro">{s.label}</p>
            <h3 class="t-h3">{s.title}</h3>
            <div class="svc__text"><p class="t-body">{s.text}</p></div>
            <Btn label={s.button} variant="secondary" />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .services { background: var(--dx-blanco); padding-block: var(--esp-8); }
  .services__inner { display: flex; flex-direction: column; gap: var(--esp-7); }
  .services__head { display: flex; flex-direction: column; gap: var(--esp-3); }
  .services__stack { display: flex; flex-direction: column; gap: var(--esp-5); }
  .svc { display: flex; flex-direction: column; gap: var(--esp-4); }
  .svc__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radio); }
  .svc__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-3);
    padding: var(--esp-4);
    border-radius: var(--radio);
    background: var(--dx-gris-claro);
  }
  .svc__progress { width: 100%; display: flex; flex-direction: column; align-items: flex-end; gap: var(--esp-2); }
  .svc__line { width: 100%; height: var(--linea); background: var(--dx-gris-medio); }
  .svc__count { font-family: var(--font-texto); font-weight: 600; font-size: var(--txt-chico); line-height: var(--lh-etiqueta); color: var(--dx-negro); }
  .svc__text { width: 100%; }
  /* Escritorio: imagen y tarjeta lado a lado; cada servicio se queda fijo y el siguiente lo cubre. */
  @media (min-width: 1024px) {
    .services { padding-block: var(--esp-9); }
    .services__stack { gap: var(--esp-6); }
    .svc { position: sticky; top: calc(var(--alto-header) + var(--esp-5)); flex-direction: row; align-items: stretch; gap: var(--medianil); }
    .svc__img, .svc__card { flex: 1 1 0; min-width: 0; }
    .svc__img { aspect-ratio: auto; height: auto; }
    .svc__card { padding: var(--esp-5); }
    .svc__text { flex: 1; display: flex; align-items: center; }
  }
</style>
