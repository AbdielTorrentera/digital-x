---
import Foto from '../Foto.astro';
import Logo from '../Logo.astro';
import type { Foto as FotoDatos } from '../../content/inicio';

// Portada del Inicio. La foto es la imagen del LCP: carga de inmediato y con prioridad alta, y el texto no espera
// a ninguna animación de entrada (que depende de JavaScript). Sin video: [PENDIENTE: clip de portada].
// Llena exactamente la pantalla visible bajo la barra fija: la barra mide `--nav-alto` y está en el flujo, así que la
// portada mide 100 % del alto de la pantalla menos esa barra (y crece si su contenido es más alto, sin cortarlo).
// Un solo H1, a la izquierda y centrado verticalmente; el logo blanco, grande, a la derecha y también centrado
// verticalmente. En móvil van en una columna (el logo arriba y el H1 debajo), sin encimarse. El logo es decorativo
// (el accesible es el de la barra).
interface Props {
  titulo: string;
  foto: FotoDatos;
}
const { titulo, foto } = Astro.props;
---

<section class="hero sobre-negro">
  <Foto class="hero__img" src={foto.src} alt={foto.alt} sizes="100vw" prioritaria />
  <div class="scrim" aria-hidden="true"></div>
  <div class="container hero__inner">
    <h1 class="hero__title">{titulo}</h1>
    <div class="hero__logo" aria-hidden="true">
      <Logo />
    </div>
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--nav-alto));
    min-height: calc(100dvh - var(--nav-alto));
    overflow: clip;
    display: flex;
    align-items: stretch;
  }
  /* Picture no le pone al <img> el atributo de alcance de Astro: se selecciona como global dentro de la sección. */
  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--dx-negro);
  }
  /* Móvil: una columna centrada verticalmente, el logo arriba y el H1 debajo. */
  .hero__inner {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--esp-6);
    padding-block: var(--esp-8);
  }
  .hero__logo {
    --logo-ancho: 200px;
    order: -1;
    color: var(--dx-blanco);
  }
  .hero__title {
    font-family: var(--font-titulos);
    font-size: var(--txt-display);
    font-weight: 800;
    line-height: var(--lh-titulo);
    letter-spacing: var(--ls-titulo);
    color: var(--dx-blanco);
    text-wrap: balance;
  }
  /* Tableta y escritorio: el H1 a la izquierda y el logo a la derecha, ambos centrados verticalmente. */
  @media (min-width: 768px) {
    .hero__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--esp-7);
    }
    .hero__title {
      max-width: 18ch;
    }
    .hero__logo {
      --logo-ancho: 280px;
      order: 0;
      flex: none;
    }
  }
  @media (min-width: 1024px) {
    .hero__logo {
      --logo-ancho: 380px;
    }
  }
</style>
