---
import Foto from '../Foto.astro';
import type { Proyecto } from '../../content/proyectos';

// Tarjeta de un proyecto (foto, título y texto corto): la usan la sección de proyectos del Inicio y la de cada página de
// servicio. Debe ir dentro de un <ul>. Mientras el proyecto sea un EJEMPLO inventado (`placeholder`), lleva la etiqueta
// EJEMPLO, amarillo sobre negro como en Nosotros; el build de producción falla mientras existan (content/proyectos.ts).
interface Props {
  proyecto: Proyecto;
  sizes?: string;
}
const { proyecto, sizes = '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw' } = Astro.props;
---

<li class="proyecto">
  <Foto class="proyecto__img" src={proyecto.foto.src} alt={proyecto.foto.alt} sizes={sizes} />
  {proyecto.placeholder && <span class="proyecto__ejemplo">EJEMPLO</span>}
  <div class="proyecto__texto">
    <h3 class="t-h3">{proyecto.titulo}</h3>
    <p class="t-body">{proyecto.texto}</p>
  </div>
</li>
<style>
  .proyecto {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radio);
    background: var(--dx-blanco);
    overflow: clip;
  }
  .proyecto :global(.proyecto__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .proyecto__ejemplo {
    position: absolute;
    top: var(--esp-4);
    right: var(--esp-4);
    padding: 2px var(--esp-2);
    border-radius: var(--radio-chico);
    background: var(--dx-amarillo);
    color: var(--dx-negro);
    font-family: var(--font-texto);
    font-size: var(--txt-chico);
    font-weight: 600;
    line-height: var(--lh-etiqueta);
  }
  .proyecto__texto {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
    padding: var(--esp-4);
  }
  @media (min-width: 1024px) {
    .proyecto__texto {
      padding: var(--esp-5);
    }
  }
</style>
