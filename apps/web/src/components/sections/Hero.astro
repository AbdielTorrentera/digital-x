---
import Btn from '../Btn.astro';
import Foto from '../Foto.astro';
import type { Foto as FotoDatos } from '../../content/inicio';

// Portada del Inicio. La foto es la imagen del LCP: carga de inmediato y con prioridad alta, y el texto no espera
// a ninguna animación de entrada (que depende de JavaScript). Sin video: [PENDIENTE: clip de portada].
interface Props {
  titulo: string;
  texto: string;
  boton: { etiqueta: string; href: string };
  foto: FotoDatos;
}
const { titulo, texto, boton, foto } = Astro.props;
---

<section class="hero sobre-negro">
  <Foto class="hero__img" src={foto.src} alt={foto.alt} sizes="100vw" prioritaria />
  <div class="scrim" aria-hidden="true"></div>
  <div class="container hero__inner">
    <h1 class="hero__title">{titulo}</h1>
    <p class="hero__text t-body c-blanco">{texto}</p>
    <Btn label={boton.etiqueta} href={boton.href} />
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: 80vh;
    overflow: clip;
    display: flex;
    align-items: flex-end;
  }
  /* Picture no le pone al <img> el atributo de alcance de Astro: se selecciona como global dentro de la sección. */
  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--dx-negro);
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
    padding-block: var(--esp-8) var(--esp-7);
  }
  .hero__title {
    font-family: var(--font-titulos);
    font-size: var(--txt-display);
    font-weight: 800;
    line-height: var(--lh-titulo);
    letter-spacing: var(--ls-titulo);
    color: var(--dx-blanco);
    text-wrap: balance;
  }
  @media (min-width: 1024px) {
    .hero {
      min-height: 85vh;
    }
    .hero__inner {
      padding-block: var(--esp-9) var(--esp-8);
    }
  }
</style>
