---
import Base from '../layouts/Base.astro';
import CierreContacto from '../components/sections/CierreContacto.astro';
import Hero from '../components/sections/Hero.astro';
import HomeAbout from '../components/sections/HomeAbout.astro';
import Servicios from '../components/sections/Servicios.astro';
import Team from '../components/sections/Team.astro';
import Features from '../components/sections/Features.astro';
import Cobertura from '../components/sections/Cobertura.astro';
import Faq from '../components/sections/Faq.astro';
import { categoriasConDestino } from '../lib/categorias';
import { mensajesWhatsApp, negocio, telUrl } from '../lib/negocio';
import { proyectosDelInicio } from '../lib/proyectos';
import { parrafoDeCategoria } from '../lib/servicios';
import { cierre, cobertura, faq, porQue, portada, proyectos, queHacemos, servicios } from '../lib/contenido/inicio';
import { proyectosPagina } from '../lib/contenido/nosotros';
import { fotosDeCategoria } from '../lib/contenido/categorias-fotos';
import { fotoCierre } from '../lib/contenido/servicios-fotos';
const proyectosVisibles = proyectosDelInicio(proyectos.items);
// Una tarjeta por categoría con al menos un servicio construido. Con un solo servicio construido, la tarjeta lleva directo a él.
const tarjetas = categoriasConDestino().map(({ categoria, href, directo, servicioUnico }, i) => ({
  contador: `/${i + 1}`,
  titulo: categoria.etiqueta,
  href,
  ariaLabel: directo
    ? `Ver ${servicioUnico!.titulo.toLowerCase()}`
    : `Ver servicios de ${categoria.etiqueta.toLowerCase()}`,
  foto: fotosDeCategoria[categoria.id],
  parrafo: parrafoDeCategoria(categoria),
  boton: directo ? 'Ver servicio' : 'Ver servicios',
}));
---

<!-- Estructura: docs/estructura-sitio-digitalx.md sección 5. Metadatos y H1: docs/reglas-seo-digitalx.md sección 1. -->
<Base
  title={portada.title}
  description={portada.descripcion}
  image={portada.imagen}
  whatsapp={mensajesWhatsApp.general}
>
  <Hero titulo={portada.h1} foto={portada.foto} />
  <HomeAbout
    etiqueta={queHacemos.etiqueta}
    titulo={queHacemos.titulo}
    texto={queHacemos.texto}
    foto={queHacemos.foto}
    boton={queHacemos.boton}
  />
  <Servicios
    id="servicios"
    etiqueta={servicios.etiqueta}
    titulo={servicios.titulo}
    etiquetaTarjeta={servicios.etiquetaTarjeta}
    items={tarjetas}
  />
  {proyectosVisibles.length > 0 && (
    <Team
      etiqueta={proyectos.etiqueta}
      titulo={proyectos.titulo}
      foto={{ src: proyectosPagina.foto, alt: '' }}
      items={proyectosVisibles}
      boton={proyectosPagina.boton}
    />
  )}
  <Features etiqueta={porQue.etiqueta} titulo={porQue.titulo} foto={porQue.foto} items={porQue.items} />
  <Cobertura {...cobertura} />
  <Faq {...faq} />
  <CierreContacto
    foto={fotoCierre}
    titulo={cierre.titulo}
    texto={cierre.texto}
    whatsapp={cierre.boton}
    llamar={{ etiqueta: 'Llamar', href: telUrl, numero: negocio.telefono.pantalla }}
  />
</Base>
