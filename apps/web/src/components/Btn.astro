---
import Icon from './Icon.astro';

// Botón de diseño §6: mínimo 48 px de alto, etiqueta de verbo + objeto y flecha que gira 45° al pasar el cursor.
// Sin `href` se dibuja un <span>, para poder ponerlo dentro de una tarjeta que ya es un enlace.
interface Props {
  label?: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'icon';
  class?: string;
  [key: string]: any;
}
const { label, href, variant = 'primary', class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class:list={['btn', `btn--${variant}`, cls]} {...rest}>
  {variant !== 'icon' && <span>{label}</span>}
  <span class="btn__icon">
    <Icon name="arrow" size="boton" />
  </span>
</Tag>
