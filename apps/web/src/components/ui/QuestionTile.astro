---
import Icon from '../Icon.astro';

// "Question card 2" de la plantilla Marby: una tarjeta numerada que se vuelve negra y muestra su respuesta. La
// respuesta es el contenido de la ranura (puede llevar enlaces). Sin JavaScript la respuesta queda visible; con JS se
// muestra al abrir. La tarjeta no tiene alto fijo: crece con el texto y con la letra grande (diseño §9).
interface Props {
  n: number;
  q: string;
  /** Prefijo del id de la respuesta, para que no choque si hay varios grupos en la página. */
  grupo?: string;
}
const { n, q, grupo = 'tile' } = Astro.props;
const id = `${grupo}-${n}`;
---

<div class="qtile" data-acc-item data-acc-trigger data-appear>
  <div class="qtile__top">
    <span class="t-h1 qtile__n">{String(n).padStart(2, '0')}</span>
    <button class="qtile__btn" type="button" aria-expanded="false" aria-controls={id} aria-label={q}>
      <Icon name="plus" size="boton" />
    </button>
  </div>
  <div class="qtile__body">
    <h3 class="t-h6 qtile__q">{q}</h3>
    <p class="t-body qtile__a" id={id}>
      <slot />
    </p>
  </div>
</div>
<style>
  .qtile {
    padding: var(--esp-4);
    border-radius: var(--radio);
    background: var(--dx-gris-tarjeta);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--esp-6);
    cursor: pointer;
  }
  .qtile__top {
    display: flex;
    align-items: flex-start;
    gap: var(--esp-2);
  }
  .qtile__n {
    flex: 1;
  }
  .qtile__btn {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--tactil);
    height: var(--tactil);
    border-radius: var(--radio);
    background: var(--dx-negro);
    color: var(--dx-blanco);
  }
  .qtile__btn :global(.icon) {
    transition: transform var(--dur-media) var(--ease);
  }
  .qtile__body {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }
  /* Sin JavaScript la respuesta queda visible, sobre el fondo claro. */
  :global(html.js) .qtile__a {
    display: none;
  }
  .qtile__a :global(a) {
    text-decoration: underline;
    text-underline-offset: var(--esp-1);
    font-weight: 600;
  }
  .qtile.is-open {
    background: var(--dx-negro);
    --foco-color: var(--dx-amarillo);
  }
  .qtile.is-open .qtile__n,
  .qtile.is-open .qtile__q,
  .qtile.is-open .qtile__a {
    color: var(--dx-blanco);
  }
  :global(html.js) .qtile.is-open .qtile__a {
    display: block;
  }
  .qtile.is-open .qtile__btn {
    background: var(--dx-blanco);
    color: var(--dx-negro);
  }
  .qtile.is-open .qtile__btn :global(.icon) {
    transform: rotate(45deg);
  }
  @media (min-width: 1024px) {
    .qtile {
      padding: var(--esp-5);
    }
  }
</style>
