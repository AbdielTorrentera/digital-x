---
import Icon from './Icon.astro';
import { textoBotonWhatsApp, waUrl } from '../lib/negocio';

// Botón flotante de WhatsApp (reglas-seo sección 11). El mensaje prellenado cambia por página.
// En móvil se reduce a un ícono al hacer scroll (scripts/whatsapp.ts); el aria-label conserva el texto completo.
interface Props { mensaje?: string }
const { mensaje } = Astro.props;
---
<a
  class="wa"
  href={waUrl(mensaje)}
  target="_blank"
  rel="noopener"
  aria-label={`${textoBotonWhatsApp}, por WhatsApp (se abre en una pestaña nueva)`}
  data-wa
>
  <Icon name="whatsapp" />
  <span class="wa__texto">{textoBotonWhatsApp}</span>
</a>
<style>
  .wa {
    position: fixed;
    right: var(--esp-4);
    bottom: var(--esp-4);
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
    min-height: var(--tactil);
    max-width: calc(100vw - 2 * var(--esp-4));
    padding: var(--esp-2) var(--esp-5) var(--esp-2) var(--esp-4);
    border-radius: var(--radio-pildora);
    /* Verde oficial de WhatsApp con ícono y texto negros: el blanco no cumple contraste (identidad sección 2). */
    background: var(--dx-whatsapp);
    color: var(--dx-negro);
    font-family: var(--font-texto);
    font-size: var(--txt-cuerpo);
    font-weight: 600;
    line-height: var(--lh-etiqueta);
    box-shadow: var(--sombra-flotante);
  }
  .wa:active { transform: translateY(var(--linea)); }
  /* Sobre el pie negro el contorno negro no se ve: un halo blanco en la separación de 2 px lo marca. */
  .wa:focus-visible { outline-color: var(--dx-negro); box-shadow: 0 0 0 var(--foco) var(--dx-blanco), var(--sombra-flotante); }
  /* Móvil: tras hacer scroll queda solo el ícono para no tapar contenido. El texto sigue en el aria-label. */
  .wa.is-compact { padding-inline: var(--esp-3); }
  .wa.is-compact .wa__texto { display: none; }
  @media (min-width: 768px) {
    .wa { right: var(--esp-5); bottom: var(--esp-5); }
    .wa.is-compact { padding-inline: var(--esp-4) var(--esp-5); }
    .wa.is-compact .wa__texto { display: block; }
  }
</style>
