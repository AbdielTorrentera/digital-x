---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import BotonLlamar from './BotonLlamar.astro';
import { telUrl } from '../lib/negocio';
import { menu } from '../lib/paginas';

const actual = Astro.url.pathname;
---
<!--
  Móvil (<1024 px): barra de 64 px con marca, "Llamar" y "Menú". El menú abre a pantalla completa
  con los enlaces pegados abajo (alcance del pulgar) y botones de 48 px.
  Escritorio: barra horizontal; "Servicios" es un desplegable de tres columnas.
  Sin JavaScript el menú queda como lista visible debajo de la barra.
-->
<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__marca" href="/"><Logo /></a>

    <div class="menu" id="menu" data-menu>
      <nav class="menu__nav" aria-label="Principal">
        <ul class="menu__lista">
          {menu.map((item) => (
            <li class:list={['menu__item', item.grupos && item.grupos.length > 0 && 'has-sub']}>
              {item.grupos && item.grupos.length > 0 ? (
                <>
                  <button class="menu__enlace menu__sub-btn" type="button" aria-expanded="false" aria-controls="sub-servicios" data-sub-toggle>
                    <span>{item.titulo}</span>
                    <Icon name="plus" size="boton" class="menu__mas" />
                  </button>
                  <div class="sub" id="sub-servicios">
                    {item.url && <a class="sub__todos" href={item.url}>Todos los servicios</a>}
                    <div class="sub__grupos">
                      {item.grupos.map((g) => (
                        <div class="sub__grupo">
                          {g.hub ? <a class="sub__titulo" href={g.hub.url}>{g.titulo}</a> : <p class="sub__titulo">{g.titulo}</p>}
                          <ul>
                            {g.servicios.map((s) => (
                              <li><a class="sub__enlace" href={s.url} aria-current={actual === s.url ? 'page' : undefined}>{s.titulo}</a></li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                <a class="menu__enlace" href={item.url} aria-current={actual === item.url ? 'page' : undefined}>{item.titulo}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="menu__movil">
        <a class="menu__btn" href={telUrl}><Icon name="phone" size="boton" /> Llamar</a>
        <button class="menu__btn menu__btn--cerrar" type="button" data-menu-close><Icon name="close" size="boton" /> Cerrar</button>
      </div>
    </div>

    <div class="nav__acciones">
      <BotonLlamar />
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
        <Icon name="menu" size="boton" />
        <span>Menú</span>
      </button>
    </div>
  </div>
</header>

<style>
  /* Estilos base: móvil. Escritorio se agrega con min-width: 1024px (diseño §1). */
  .nav {
    position: sticky;
    top: 0;
    /* Por encima del botón de WhatsApp (z 20) para que el menú abierto lo cubra. */
    z-index: 40;
    background: var(--dx-blanco);
    color: var(--dx-negro);
    /* La línea inferior va dentro de la altura del header (64 px), no suma a ella. */
    box-shadow: inset 0 calc(-1 * var(--linea)) 0 var(--dx-gris-claro);
  }
  .nav__bar {
    max-width: calc(var(--contenedor) + 2 * var(--margen));
    margin-inline: auto;
    padding: var(--esp-2) var(--margen);
    min-height: var(--alto-header);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-2);
  }
  .nav__marca {
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
    color: var(--dx-negro);
  }
  .nav__acciones { display: flex; align-items: center; gap: var(--esp-2); }
  .nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
    min-height: var(--tactil);
    padding-inline: var(--esp-3);
    border-radius: var(--radio);
    background: var(--dx-negro);
    color: var(--dx-blanco);
    font-size: var(--txt-cuerpo);
    font-weight: 600;
    line-height: var(--lh-etiqueta);
  }
  :global(html:not(.js)) .nav__toggle { display: none; }

  /* ---------- menú: panel a pantalla completa en móvil ---------- */
  .menu { flex: 1 0 100%; order: 3; }
  .menu__lista { display: flex; flex-direction: column; gap: var(--esp-2); }
  .menu__enlace {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: var(--tactil);
    padding: var(--esp-3) var(--esp-1);
    font-family: var(--font-titulos);
    font-size: var(--txt-h3);
    font-weight: 800;
    line-height: var(--lh-h3);
    text-align: left;
    color: var(--dx-negro);
    border-top: var(--linea) solid var(--dx-gris-medio);
  }
  .menu__enlace[aria-current='page'] { text-decoration: underline; text-underline-offset: var(--esp-2); }
  .menu__mas { transition: transform var(--dur-media) var(--ease); }
  .menu__sub-btn[aria-expanded='true'] .menu__mas { transform: rotate(45deg); }

  .sub { padding-bottom: var(--esp-3); }
  .sub ul { display: flex; flex-direction: column; gap: var(--esp-2); }
  .sub__grupos { display: flex; flex-direction: column; gap: var(--esp-2); }
  :global(html.js) .sub:not(.is-open) { display: none; }
  .sub__todos,
  .sub__enlace,
  .sub__titulo {
    display: flex;
    align-items: center;
    min-height: var(--tactil);
    padding: 0 var(--esp-1) 0 var(--esp-4);
    font-size: var(--txt-cuerpo);
    color: var(--dx-negro);
  }
  .sub__todos { margin-bottom: var(--esp-2); }
  .sub__todos,
  .sub__titulo { font-weight: 600; }
  .sub__enlace[aria-current='page'] { text-decoration: underline; text-underline-offset: var(--esp-1); }

  .menu__movil { display: none; }

  :global(html.js) .menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 30;
    flex-direction: column;
    gap: var(--esp-4);
    padding: var(--margen) var(--margen) max(var(--margen), env(safe-area-inset-bottom));
    background: var(--dx-gris-claro);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* margin-top:auto pega los enlaces abajo sin perder el scroll cuando el contenido es más alto que la pantalla. */
  :global(html.js) .menu__nav { margin-top: auto; }
  :global(html.js) .menu.is-open { display: flex; animation: menu-in var(--dur-media) var(--ease); }
  /* Llamar y Cerrar quedan siempre a la vista, aunque el panel tenga que hacer scroll. */
  :global(html.js) .menu__movil {
    display: flex;
    gap: var(--esp-2);
    position: sticky;
    bottom: calc(-1 * max(var(--margen), env(safe-area-inset-bottom)));
    margin-bottom: calc(-1 * max(var(--margen), env(safe-area-inset-bottom)));
    padding-block: var(--esp-3) max(var(--margen), env(safe-area-inset-bottom));
    background: var(--dx-gris-claro);
  }
  .menu__btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: var(--tactil);
    border-radius: var(--radio);
    background: var(--dx-blanco);
    color: var(--dx-negro);
    font-size: var(--txt-cuerpo);
    font-weight: 600;
  }
  .menu__btn--cerrar { background: var(--dx-negro); color: var(--dx-blanco); }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(var(--esp-4)); }
    to { opacity: 1; transform: none; }
  }

  /* ---------- escritorio ---------- */
  @media (min-width: 1024px) {
    .nav__bar { flex-wrap: nowrap; gap: var(--esp-5); }
    .nav__toggle { display: none; }
    .menu { flex: 1; order: 0; display: flex; justify-content: center; }
    /* Deshace el panel a pantalla completa de móvil (esas reglas llevan html.js y ganarían por especificidad). */
    :global(html.js) .menu {
      display: flex;
      position: static;
      z-index: auto;
      flex-direction: row;
      gap: 0;
      padding: 0;
      background: none;
      overflow: visible;
    }
    :global(html.js) .menu.is-open { animation: none; }
    :global(html.js) .menu__nav { margin-top: 0; }
    :global(html.js) .menu__movil { display: none; }
    .menu__lista { flex-direction: row; gap: var(--esp-2); }
    .menu__item { position: relative; }
    .menu__enlace {
      width: auto;
      gap: var(--esp-2);
      padding: 0 var(--esp-4);
      border-top: 0;
      border-radius: var(--radio);
      font-size: var(--txt-cuerpo);
      line-height: var(--lh-etiqueta);
    }
    .menu__enlace:hover,
    .menu__sub-btn[aria-expanded='true'] { background: var(--dx-gris-claro); }
    .menu__mas { width: var(--icono-boton); height: var(--icono-boton); }
    .sub {
      position: absolute;
      top: calc(100% + var(--esp-2));
      left: 0;
      width: max-content;
      max-width: calc(100vw - 2 * var(--margen));
      padding: var(--esp-5);
      background: var(--dx-blanco);
      border: var(--linea) solid var(--dx-gris-claro);
      border-radius: var(--radio);
      box-shadow: var(--sombra-flotante);
    }
    .sub__grupos { display: grid; grid-template-columns: repeat(3, max-content); gap: var(--esp-5); }
    .sub__todos,
    .sub__enlace,
    .sub__titulo { padding: 0 var(--esp-2); border-radius: var(--radio-chico); }
    .sub__enlace:hover,
    .sub__todos:hover,
    a.sub__titulo:hover { background: var(--dx-gris-claro); color: var(--dx-negro); }
  }
</style>
