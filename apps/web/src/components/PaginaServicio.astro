---
import Base from '../layouts/Base.astro';
import Foto from './Foto.astro';
import Icon from './Icon.astro';
import Btn from './Btn.astro';
import GaleriaServicio from './GaleriaServicio.astro';
import Migas from './Migas.astro';
import NavInterna from './NavInterna.astro';
import CierreContacto from './sections/CierreContacto.astro';
import Faq from './sections/Faq.astro';
import Team from './sections/Team.astro';
import TextoConEnlaces from './ui/TextoConEnlaces.astro';
import { fotoCierre, type FotoDeServicio } from '../content/servicios-fotos';
import { proyectosPagina } from '../content/nosotros';
import { proyectos as proyectosDelSitio } from '../content/proyectos';
import { categorias } from '../content/categorias';
import { faltantesDePagina, servicios, type EnlaceRelacionado, type Slug } from '../content/servicios';
import { enlaceAPagina } from '../lib/enlaces';
import { serializarJsonLd, serviceJsonLd } from '../lib/jsonld';
import { idNegocio, negocio, telUrl, waUrl, zonas } from '../lib/negocio';
import { paginas, servicioPorSlug, visible } from '../lib/paginas';
import { proyectosDeServicio } from '../lib/proyectos';
import { enlaceDeServicio } from '../lib/servicios';

// Plantilla de la página de un servicio: la página de detalle de la plantilla Marby (migas, barra con el título, foto
// con ficha, navegación interna, descripción, lista de lo que incluye, enlaces relacionados, tarjeta de cotización,
// preguntas frecuentes y galería). Se quitan la tarjeta de asesor, el mapa y el lightbox: no hay datos ni material.
// Solo se genera para un servicio con `construida: true` y con su contenido completo (pages/[categoria]/[slug].astro).
interface Props {
  slug: Slug;
  foto: FotoDeServicio;
}
const { slug, foto } = Astro.props;

const faltan = faltantesDePagina(slug);
if (faltan.length > 0)
  throw new Error(`La página de ${slug} no tiene su contenido completo: falta ${faltan.join(', ')}.`);

const registro = servicioPorSlug(slug)!;
const c = servicios[slug];
const p = c.pagina!;
const ficha = p.ficha!;
const descripcion = p.descripcion!;
const tambien = p.tambien!;
const cotizacion = p.cotizacion!;
const cierre = p.cierre!;
const secciones = p.secciones ?? [];
const nota = p.incluyeNota;
const galeria = foto.galeria?.some((s) => s.fotos.length > 0) ? foto.galeria : undefined;

// La categoría del servicio (su etiqueta y su nombre) sale de los datos de las categorías, no de constantes de este
// componente. Su miga solo existe si la categoría tiene página propia (con un solo servicio construido no la tiene).
const categoria = categorias.find((c) => c.id === registro.categoria)!;
const paginaDeCategoria = paginas.find((p) => p.paginaDe === registro.categoria && visible(p));
const nombre = registro.titulo;
const url = new URL(registro.url, negocio.url).href;

// Un servicio sin página no se enlaza: se omite de la lista (sus datos siguen completos).
const enlaceDe = (item: EnlaceRelacionado) =>
  'slug' in item
    ? { titulo: servicioPorSlug(item.slug)!.titulo, href: enlaceDeServicio(item.slug) }
    : { titulo: item.titulo, href: enlaceAPagina(item.url) };
const relacionados = tambien.items
  .map((item) => ({ ...enlaceDe(item), texto: item.texto }))
  .filter((item): item is { titulo: string; href: string; texto: string } => item.href !== null);

// Hasta 3 proyectos que usaron este servicio (de ejemplo, con la etiqueta EJEMPLO, mientras no haya reales). Sin ninguno,
// la sección no se dibuja ni se enlaza.
const proyectos = proyectosDeServicio(proyectosDelSitio, nombre);

const salto = [
  { href: '#descripcion', etiqueta: 'Descripción' },
  { href: '#que-incluye', etiqueta: 'Qué incluye' },
  ...secciones.map((s) => ({ href: `#${s.id}`, etiqueta: s.etiqueta })),
  { href: '#te-puede-servir', etiqueta: 'Te puede servir' },
  ...(proyectos.length > 0 ? [{ href: '#proyectos', etiqueta: 'Proyectos' }] : []),
];
const nombreEnMinuscula = nombre.toLowerCase();
const datosEstructurados = serviceJsonLd({
  url,
  nombre,
  tipo: c.serviceType ?? categoria.titulo,
  descripcion: c.descripcion,
  idNegocio,
  zonas: [...zonas.todas],
});
---

<!-- Estructura: docs/estructura-sitio-digitalx.md sección 5. Metadatos y H1: docs/reglas-seo-digitalx.md sección 1. -->
<Base title={c.title} description={c.meta} whatsapp={c.mensaje}>
  <header class="enc">
    <div class="enc__foto">
      <Foto class="enc__img" src={foto.src} alt={foto.alt} sizes="(min-width: 1024px) 50vw, 100vw" prioritaria />
      {galeria && (
        <button class="enc__ver t-body-sm" type="button" data-galeria-abrir>
          Ver todas las fotos
        </button>
      )}
    </div>
    <div class="enc__texto">
      <div class="enc__interior">
        <Migas
          items={[
            { titulo: 'Inicio', url: '/' },
            ...(paginaDeCategoria ? [{ titulo: categoria.etiqueta, url: paginaDeCategoria.url }] : []),
            { titulo: nombre, url: registro.url },
          ]}
        />
        <p class="enc__etiqueta t-caption2">{categoria.etiqueta}</p>
        <h1 class="t-h1">{c.h1}</h1>
        <dl class="enc__ficha">
          {ficha.map((fila) => (
            <div class="enc__fila">
              <dt class="t-caption2">{fila.etiqueta}</dt>
              <dd class="t-body">{fila.valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </header>
  <section class:list={['srv', { 'srv--con-proyectos': proyectos.length > 0 }]}>
    <div class="container srv__inner">
      <div class="srv__contenido">
        <div class="srv__izquierda">
          <NavInterna items={salto} />
          <div class="prose srv__bloque" id="descripcion" data-appear>
            <h2>{descripcion.titulo}</h2>
            {descripcion.parrafos.map((parrafo) => (
              <p>{parrafo}</p>
            ))}
          </div>
          <div class="srv__bloque" id="que-incluye" data-appear>
            <h2 class="t-h2">Qué incluye</h2>
            <ul class="inc">
              {p.incluye!.map((item) => (
                <li class="inc__item">
                  <span class="inc__icono">
                    <Icon name="check" />
                  </span>
                  <span class="t-body">{item}</span>
                </li>
              ))}
            </ul>
            {nota && (
              <p class="t-body srv__nota">
                <TextoConEnlaces texto={nota} />
              </p>
            )}
          </div>
          {secciones.map((seccion) => (
            <div class="prose srv__bloque" id={seccion.id} data-appear>
              <h2>{seccion.titulo}</h2>
              {seccion.bloques.map((bloque) =>
                'parrafo' in bloque ? (
                  <p>
                    <TextoConEnlaces texto={bloque.parrafo} />
                  </p>
                ) : 'lista' in bloque ? (
                  <ul>
                    {bloque.lista.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                ) : (
                  <ul>
                    {bloque.puntos.map((punto) => (
                      <li>
                        <strong>
                          <TextoConEnlaces texto={punto.titulo} />:
                        </strong>{' '}
                        <TextoConEnlaces texto={punto.texto} />
                      </li>
                    ))}
                  </ul>
                ),
              )}
            </div>
          ))}
          <div class="srv__bloque" id="te-puede-servir" data-appear>
            <h2 class="t-h2">También te puede servir</h2>
            {tambien.intro && <p class="t-body srv__intro">{tambien.intro}</p>}
            <ul class="cerca">
              {relacionados.map((item) => (
                <li>
                  <a class="cerca__enlace" href={item.href}>
                    <span class="cerca__titulo t-h3">{item.titulo}</span>
                    <span class="t-body">{item.texto}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <aside class="srv__lateral">
          <div class="cotiza sobre-negro">
            <p class="t-caption2 c-gris">{cotizacion.etiqueta}</p>
            <p class="t-body c-blanco">{cotizacion.texto}</p>
            <Btn
              label="Cotizar por WhatsApp"
              href={waUrl(c.mensaje)}
              target="_blank"
              rel="noopener"
              aria-label="Cotizar por WhatsApp (se abre en una pestaña nueva)"
            />
          </div>
        </aside>
      </div>
    </div>
  </section>
  {proyectos.length > 0 && (
    <div class="srv__proyectos" id="proyectos">
      <Team
        etiqueta={proyectosPagina.etiqueta}
        titulo={`Proyectos de ${nombre.toLowerCase()}`}
        foto={{ src: proyectosPagina.foto, alt: '' }}
        items={proyectos}
        boton={proyectosPagina.boton}
      />
    </div>
  )}
  {p.faq?.length ? (
    <Faq
      etiqueta="Preguntas frecuentes"
      titulo={`Preguntas frecuentes sobre ${nombreEnMinuscula}`}
      texto={`Lo que más nos preguntan sobre ${nombreEnMinuscula}.`}
      items={p.faq}
    />
  ) : null}
  <CierreContacto
    foto={fotoCierre}
    titulo={cierre.titulo}
    texto={cierre.texto}
    whatsapp={{ etiqueta: 'Cotizar por WhatsApp', href: waUrl(c.mensaje) }}
    llamar={{ etiqueta: 'Llamar', href: telUrl, numero: negocio.telefono.pantalla }}
  />
  {galeria && <GaleriaServicio nombre={nombre} secciones={galeria} mensaje={c.mensaje} />}
  <script type="application/ld+json" set:html={serializarJsonLd(datosEstructurados)} />
</Base>
<style>
  /* Encabezado dividido (la sección de videoclips de mandmfilmsmx.com): foto a la mitad izquierda, a todo lo alto, y a la
     derecha la etiqueta de categoría, el H1 grande y los tres datos del servicio, sobre un fondo claro de la paleta. En
     móvil, la foto arriba y el texto abajo. El alto es mínimo: el texto crece con el zoom y la letra grande (diseño §9).
     Las migas van arriba de la etiqueta, dentro de la columna de texto. <picture> no pinta caja. */
  .enc {
    background: var(--dx-gris-tarjeta);
    display: flex;
    flex-direction: column;
  }
  .enc__foto {
    position: relative;
    min-width: 0;
  }
  .enc__foto :global(picture) {
    display: contents;
  }
  .enc__foto :global(.enc__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  /* Botón de la galería (solo si el servicio tiene galería): fondo sólido, para que se lea sobre cualquier foto. */
  .enc__ver {
    position: absolute;
    right: var(--esp-4);
    bottom: var(--esp-4);
    min-height: var(--tactil);
    padding: var(--esp-1) var(--esp-4);
    border-radius: var(--radio-chico);
    background: var(--dx-gris-tarjeta);
    color: var(--dx-negro);
  }
  /* El modal de la galería necesita JavaScript: sin él, el botón no se muestra. */
  :global(html:not(.js)) .enc__ver {
    display: none;
  }
  .enc__texto {
    min-width: 0;
    padding: var(--esp-5) var(--margen) var(--esp-7);
  }
  .enc__interior {
    display: flex;
    flex-direction: column;
    gap: var(--esp-4);
  }
  .enc__etiqueta {
    margin-top: var(--esp-3);
  }
  .enc__ficha {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .enc__fila {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
    padding-block: var(--esp-3);
    box-shadow: inset 0 calc(-1 * var(--linea)) 0 var(--dx-gris-medio);
  }
  .enc__fila:last-child {
    box-shadow: none;
  }
  .enc__fila dd {
    margin: 0;
  }

  .srv {
    background: var(--dx-blanco);
    padding-block: var(--esp-6) var(--esp-8);
  }
  .srv__inner {
    display: flex;
    flex-direction: column;
    gap: var(--esp-5);
  }

  .srv__contenido {
    display: flex;
    flex-direction: column;
    gap: var(--esp-7);
  }
  .srv__izquierda {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--esp-7);
  }
  /* Los títulos de sección no quedan bajo el menú ni bajo la barra de navegación interna al saltar a ellos. */
  .srv__bloque {
    scroll-margin-top: calc(var(--nav-alto) + var(--salto-alto) + var(--esp-4));
  }
  .srv__bloque > :global(h2),
  .srv__bloque > .t-h2 {
    margin-bottom: var(--esp-5);
  }
  .srv__bloque.prose > :global(h2) {
    margin-bottom: 0;
  }
  .srv__intro {
    margin-top: calc(-1 * var(--esp-3));
    margin-bottom: var(--esp-4);
  }
  .srv__nota {
    margin-top: var(--esp-5);
  }
  /* Los puntos con título de las secciones ("Por hora: …") llevan el título en negrita de la fuente de textos. */
  .srv__bloque :global(strong) {
    font-weight: 600;
  }

  /* Lo que incluye (los highlights de Marby): una fila por inclusión, con su palomita. */
  .inc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--esp-4);
  }
  .inc__item {
    display: flex;
    align-items: center;
    gap: var(--esp-3);
  }
  .inc__icono {
    flex: none;
    display: grid;
    place-items: center;
    padding: var(--esp-2);
    border-radius: var(--radio-chico);
    background: var(--dx-gris-tarjeta);
  }

  /* "También te puede servir": filas con línea, como la lista de lugares cercanos de Marby. */
  .cerca {
    display: flex;
    flex-direction: column;
  }
  .cerca li {
    box-shadow: inset 0 calc(-1 * var(--linea)) 0 var(--dx-gris-medio);
  }
  .cerca li:last-child {
    box-shadow: none;
  }
  .cerca__enlace {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
    min-height: var(--tactil);
    padding-block: var(--esp-3);
  }
  .cerca__titulo {
    text-decoration: underline;
    text-underline-offset: var(--esp-1);
  }
  .cerca__enlace:hover .cerca__titulo {
    text-decoration-thickness: var(--foco);
  }

  /* Tarjeta de cotización (la tarjeta oscura del lateral de Marby): la única acción principal de la página. */
  .cotiza {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
    padding: var(--esp-5);
    border-radius: var(--radio);
  }

  @media (min-width: 768px) {
    .inc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cerca__enlace {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--esp-5);
    }
  }
  @media (min-width: 1024px) {
    /* Escritorio: dos mitades; la foto ocupa toda la mitad izquierda, de borde a borde y a todo lo alto. */
    .enc {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: clamp(520px, calc(100dvh - var(--nav-alto)), 720px);
    }
    .enc__foto :global(.enc__img) {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
    }
    .enc__texto {
      display: flex;
      align-items: center;
      padding: var(--esp-7);
    }
    .srv {
      padding-block: var(--esp-8) var(--esp-9);
    }
    .srv.srv--con-proyectos {
      padding-bottom: 0;
    }
    .srv__contenido {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--medianil);
    }
    .srv__izquierda {
      flex: 1 1 0;
    }
    .srv__lateral {
      flex: none;
      width: 340px;
      position: sticky;
      top: calc(var(--nav-alto) + var(--esp-4));
    }
  }
  /* Sin proyectos después, el contenido deja su relleno inferior; con ellos, la foto del bloque empieza justo donde termina
     el contenido (si no, queda una franja blanca vacía arriba de la foto). */
  .srv.srv--con-proyectos {
    padding-bottom: 0;
  }
  /* El carrusel de proyectos (el de Nosotros) va a todo el ancho, después del contenido; el salto "Proyectos" llega aquí
     dejando libre la barra del menú. */
  .srv__proyectos {
    scroll-margin-top: var(--nav-alto);
  }
</style>
