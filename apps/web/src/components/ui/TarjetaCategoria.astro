---
import Btn from '../Btn.astro';
import Foto from '../Foto.astro';
import { enlaceAPagina } from '../../lib/enlaces';
import type { Foto as FotoDatos } from '../../content/inicio';

// Tarjeta de categoría del hub /servicios/: la PropertyCard de la plantilla Marby (foto, barra con el nombre y el
// contador, y filas de datos). Aquí las filas dicen para quién es y qué servicios incluye. La tarjeta ENTERA es un solo
// enlace a la página de la categoría (se enlaza aunque aún no exista; producción no compila así) y el botón es un
// <span> decorativo: la zona de toque es la tarjeta. Sin la barra que solo aparece al pasar el cursor, que en
// pantallas táctiles no existe.
interface Props {
  titulo: string;
  contador: string;
  para: string;
  servicios: string[];
  url: string;
  boton: string;
  foto: FotoDatos;
}
const { titulo, contador, para, servicios, url, boton, foto } = Astro.props;
---

<a class="tcat hover-target" href={enlaceAPagina(url)} aria-label={boton}>
  <Foto class="tcat__img" src={foto.src} alt={foto.alt} sizes="(min-width: 768px) 50vw, 100vw" />
  <div class="tcat__nombre">
    <h2 class="t-h3">{titulo}</h2>
    <p class="t-caption" aria-hidden="true">
      {contador}
    </p>
  </div>
  <dl class="tcat__lista">
    <div class="tcat__fila">
      <dt class="t-caption2">Para</dt>
      <dd class="t-body">{para}</dd>
    </div>
    <div class="tcat__fila">
      <dt class="t-caption2">Servicios</dt>
      <dd>
        <ul class="tcat__servicios">
          {servicios.map((servicio) => (
            <li class="t-body">{servicio}</li>
          ))}
        </ul>
      </dd>
    </div>
  </dl>
  <Btn class="tcat__boton" label={boton} variant="secondary" />
</a>
<style>
  .tcat {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
    min-width: 0;
  }
  /* <picture> no pinta caja: el <img> es el elemento del flujo. Picture no le pone el atributo de alcance de Astro. */
  .tcat :global(picture) {
    display: contents;
  }
  .tcat :global(.tcat__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radio);
  }
  .tcat__nombre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-4);
    padding: var(--esp-3) var(--esp-4);
    border-radius: var(--radio);
    background: var(--dx-gris-claro);
  }
  .tcat__lista {
    flex: 1;
    margin: 0;
    padding-inline: var(--esp-4);
    display: flex;
    flex-direction: column;
  }
  .tcat__fila {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
    padding-block: var(--esp-3);
    box-shadow: inset 0 calc(-1 * var(--linea)) 0 var(--dx-gris-medio);
  }
  .tcat__fila:last-child {
    box-shadow: none;
  }
  .tcat__fila dd {
    margin: 0;
  }
  .tcat__servicios {
    display: flex;
    flex-direction: column;
  }
  .tcat :global(.tcat__boton) {
    align-self: flex-start;
    margin-inline: var(--esp-4);
  }
</style>
