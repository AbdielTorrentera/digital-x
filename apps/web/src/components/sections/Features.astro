---
import Foto from '../Foto.astro';
import type { Foto as FotoDatos } from '../../content/inicio';

// "Por qué Digital X": solo hechos comprobables (estructura-sitio sección 5). El texto de cada tarjeta se ve siempre,
// no solo al pasar el cursor, para que también se lea con teclado y en pantallas táctiles.
interface Props {
  etiqueta: string;
  titulo: string;
  foto: FotoDatos;
  items: { titulo: string; texto: string }[];
}
const { etiqueta, titulo, foto, items } = Astro.props;
---

<section class="features sobre-negro">
  <Foto class="features__bg" src={foto.src} alt={foto.alt} sizes="100vw" />
  <div class="container features__inner">
    <div class="features__head">
      <p class="t-caption2 c-blanco">{etiqueta}</p>
      <h2 class="t-h2 c-blanco">{titulo}</h2>
    </div>
    <ul class="features__grid">
      {items.map((item) => (
        <li class="fcard">
          <h3 class="t-h3 c-blanco">{item.titulo}</h3>
          <p class="t-body c-blanco">{item.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .features {
    position: relative;
    overflow: clip;
    padding-block: var(--esp-8);
  }
  .features :global(.features__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .features__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--esp-7);
  }
  .features__head {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
  }
  .features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--esp-5);
  }
  .fcard {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
    padding: var(--esp-4);
    border-radius: var(--radio);
    border: var(--linea) solid var(--dx-linea-sobre-foto);
    background: var(--dx-capa-oscura);
    -webkit-backdrop-filter: blur(var(--desenfoque));
    backdrop-filter: blur(var(--desenfoque));
  }
  @media (min-width: 768px) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .features {
      padding-block: var(--esp-9);
    }
    .features__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--esp-6);
    }
    .fcard {
      padding: var(--esp-5);
    }
  }
</style>
