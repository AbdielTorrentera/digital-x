# Todas opcionales. Sin valores, el build sale limpio.

# "true" carga Vercel Web Analytics y Speed Insights.
PUBLIC_VERCEL_ANALYTICS=

# Lo define Vercel solo. Solo VERCEL_ENV=production se indexa; local y previews salen con noindex y robots.txt bloqueado.
# Para probar el build de producción en local: VERCEL_ENV=production pnpm build
# VERCEL_ENV=

# Contenido de Sanity (sin token: el dataset es público y solo se lee lo publicado). `pnpm build` y `pnpm dev` lo bajan
# solos a .contenido/sanity.json. Ver scripts/descargar-contenido.ts.
# SANITY_DATASET=pruebas    otro dataset, solo para desarrollo (por defecto, production)
# CONTENIDO_JSON=ruta.json  usa ese archivo en lugar de bajar nada (así corren las pruebas)
