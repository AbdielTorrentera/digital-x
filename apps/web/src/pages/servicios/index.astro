---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Migas from '../../components/Migas.astro';
import NavInterna from '../../components/NavInterna.astro';
import CierreContacto from '../../components/sections/CierreContacto.astro';
import GuiaServicios from '../../components/sections/GuiaServicios.astro';
import TarjetaServicio from '../../components/ui/TarjetaServicio.astro';
import { catalogo, servicios } from '../../content/servicios';
import { fotoCierre, fotoPortada, fotos } from '../../content/servicios-fotos';
import { collectionPageJsonLd, serializarJsonLd } from '../../lib/jsonld';
import { idNegocio, mensajesWhatsApp, negocio, telUrl, waUrl } from '../../lib/negocio';
import { paginas, slugDe } from '../../lib/paginas';
import { partesDeSlugs, serviciosDe } from '../../lib/servicios';
import type { Slug } from '../../content/servicios';

// Catálogo: la página de listado de la plantilla Marby (portada con foto, barra de pestañas y cuadrícula de tarjetas) con
// los servicios agrupados en 3 secciones (#audio, #video y #tecnologia). Las pestañas son saltos a cada sección, no un
// filtro: todo el contenido está en el HTML y funciona sin JavaScript. Cada tarjeta enlaza a la página del servicio solo
// si está construida; si no, es texto.
// Estructura: docs/estructura-sitio-digitalx.md sección 5. Metadatos y H1: docs/reglas-seo-digitalx.md sección 1.
const todos = paginas.filter((p) => p.categoria);
const secciones = catalogo.secciones.map((seccion) => ({
  ...seccion,
  tarjetas: serviciosDe(seccion.categoria).map((servicio) => {
    const slug = servicio.slug as Slug;
    return {
      ...servicio,
      numero: String(todos.findIndex((p) => slugDe(p.url) === slug) + 1).padStart(2, '0'),
      contenido: servicios[slug],
      foto: fotos[slug],
    };
  }),
}));
const guia = catalogo.guia.items.map((item) => ({ escenario: item.escenario, partes: partesDeSlugs(item.slugs) }));
const salto = [
  { href: '#catalogo', etiqueta: 'Todos' },
  ...catalogo.secciones.map((s) => ({ href: `#${s.id}`, etiqueta: s.etiqueta })),
];

const url = new URL('/servicios/', negocio.url).href;
// Solo los servicios con página publicada entran al ItemList; hoy puede quedar sin él (jsonld.ts lo omite si está vacío).
const datosEstructurados = collectionPageJsonLd({
  url,
  nombre: catalogo.title,
  descripcion: catalogo.descripcion,
  idNegocio,
  elementos: todos
    .filter((p) => p.construida && p.estado === 'lanzamiento')
    .map((p) => ({ name: p.titulo, url: new URL(p.url, negocio.url).href })),
});
---

<Base title={catalogo.title} description={catalogo.descripcion} whatsapp={mensajesWhatsApp.general}>
  <div class="container cabeza">
    <Migas
      items={[
        { titulo: 'Inicio', url: '/' },
        { titulo: 'Servicios', url: '/servicios/' },
      ]}
    />
  </div>
  <section class="phero sobre-negro">
    <Foto class="phero__img" src={fotoPortada.src} alt={fotoPortada.alt} sizes="100vw" prioritaria />
    <div class="container phero__inner">
      <h1 class="t-h1 c-blanco">{catalogo.h1}</h1>
    </div>
  </section>
  <section class="plist" id="catalogo">
    <div class="container plist__inner">
      <p class="t-body plist__intro">{catalogo.intro}</p>
      <NavInterna etiqueta="Secciones del catálogo" items={salto} />
      {secciones.map((seccion) => (
        <section class="plist__seccion" id={seccion.id} aria-labelledby={`titulo-${seccion.id}`}>
          <div class="plist__titulo" data-appear>
            <h2 class="t-h2" id={`titulo-${seccion.id}`}>
              {seccion.titulo}
            </h2>
            <p class="t-body">{seccion.para}</p>
          </div>
          <ul class="plist__grid">
            {seccion.tarjetas.map((tarjeta) => (
              <li data-appear>
                <TarjetaServicio
                  slug={tarjeta.slug}
                  titulo={tarjeta.titulo}
                  numero={tarjeta.numero}
                  descripcion={tarjeta.contenido.descripcion}
                  para={tarjeta.contenido.para}
                  incluye={tarjeta.contenido.incluye}
                  url={tarjeta.construida ? tarjeta.url : null}
                  foto={tarjeta.foto}
                />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <GuiaServicios etiqueta={catalogo.guia.etiqueta} titulo={catalogo.guia.titulo} items={guia} />
  <CierreContacto
    foto={fotoCierre}
    titulo={catalogo.cierre.titulo}
    texto={catalogo.cierre.texto}
    whatsapp={{ etiqueta: 'Cotizar por WhatsApp', href: waUrl(catalogo.cierre.mensaje) }}
    llamar={{ etiqueta: 'Llamar', href: telUrl, numero: negocio.telefono.pantalla }}
  />
  <script type="application/ld+json" set:html={serializarJsonLd(datosEstructurados)} />
</Base>
<style>
  .cabeza {
    background: var(--dx-blanco);
  }
  /* La portada de la página de listado de Marby: foto a todo el ancho con el título encima. En lugar de la franja
     de vidrio, la foto se oscurece (--dx-brillo-sobre-foto) para que el texto blanco cumpla el contraste (marca §3).
     El alto es mínimo, no fijo: el título crece con el zoom y la letra grande (diseño §9). */
  .phero {
    position: relative;
    min-height: 280px;
    overflow: clip;
    display: flex;
    align-items: center;
  }
  /* Picture no le pone al <img> el atributo de alcance de Astro: se selecciona como global dentro de la sección. */
  .phero :global(.phero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .phero__inner {
    position: relative;
    padding-block: var(--esp-7);
  }
  .phero__inner h1 {
    max-width: 20ch;
  }

  .plist {
    background: var(--dx-blanco);
    padding-block: var(--esp-8);
    /* "Todos" salta al principio del catálogo, debajo del menú. */
    scroll-margin-top: var(--nav-alto);
  }
  .plist__inner {
    display: flex;
    flex-direction: column;
    gap: var(--esp-6);
  }
  .plist__seccion {
    display: flex;
    flex-direction: column;
    gap: var(--esp-6);
    scroll-margin-top: calc(var(--nav-alto) + var(--salto-alto) + var(--esp-4));
  }
  .plist__titulo {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
  }
  .plist__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--esp-6);
  }
  @media (min-width: 768px) {
    .phero {
      min-height: 400px;
    }
    .plist__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--medianil);
      row-gap: var(--esp-7);
    }
  }
  @media (min-width: 1024px) {
    .plist {
      padding-block: var(--esp-9);
    }
    .plist__inner {
      gap: var(--esp-7);
    }
    .plist__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
