---
import Btn from '../Btn.astro';
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import type { Foto as FotoDatos } from '../../content/inicio';
import type { Proyecto } from '../../content/proyectos';

// Fila de tarjetas que se desplaza sola: el Team de la plantilla Marby, con proyectos en lugar de personas (foto,
// número, título, servicios como etiquetas, municipio con su ícono y un texto corto). Cada tarjeta enlaza a /proyectos/.
// Solo cambian los textos, los colores (tokens --dx-*), las tipografías y lo que exigen las reglas: la fila se pausa
// con el cursor o el foco, y con movimiento reducido se detiene y se desplaza con el dedo o el teclado; la foto no
// depende del cursor en pantallas táctiles. La copia que repite la fila queda fuera del foco y de los lectores de
// pantalla. Esta pieza solo pinta: la protección contra los ejemplos vive en content/proyectos.ts.
interface Props {
  etiqueta: string;
  titulo: string;
  foto: FotoDatos;
  items: Proyecto[];
  boton: { etiqueta: string; href: string };
}
const { etiqueta, titulo, foto, items, boton } = Astro.props;
// Velocidad de la fila: 50 px por segundo, como en la plantilla.
const loop = items.length * (278 + 20);
---

<section class="team sobre-negro">
  <Foto class="team__bg" src={foto.src} alt="" sizes="100vw" />
  <div class="container team__inner" data-appear style="--appear-y:0px">
    <div class="team__head">
      <p class="t-caption2 c-blanco team__label" data-appear>
        {etiqueta}
      </p>
      <div class="team__text">
        <h2 class="t-h2 c-blanco" data-appear style="--appear-delay:0.1s">
          {titulo}
        </h2>
      </div>
    </div>
    <div
      class="ticker"
      role="region"
      aria-label="Proyectos"
      tabindex="0"
      data-appear
      style={`--appear-delay:0.3s;--loop:${loop}px;--dur:${loop / 50}s`}
    >
      <div class="ticker__track">
        {[0, 1].map((copia) => (
          <div class="ticker__set" aria-hidden={copia === 1 ? 'true' : undefined}>
            {items.map((p, i) => (
              <a
                class="member"
                href={boton.href}
                aria-label={`Ver proyectos: ${p.titulo}`}
                tabindex={copia === 1 ? -1 : undefined}
              >
                <Foto
                  class="member__photo"
                  src={p.foto.src}
                  alt={copia === 0 ? p.foto.alt : ''}
                  sizes="278px"
                  widths={[278, 556, 834]}
                />
                <div class="member__blur" aria-hidden="true" />
                <div class="member__body">
                  <div class="member__name">
                    <p class="t-caption c-blanco">{String(i + 1).padStart(2, '0')}</p>
                    <h3 class="t-h4 c-blanco">{p.titulo}</h3>
                    <p class="t-caption c-blanco">{p.texto}</p>
                  </div>
                  <div class="member__meta">
                    <p class="t-caption c-blanco">{p.servicios.join(' · ')}</p>
                    <p class="t-caption c-blanco member__city">
                      <Icon name="pin" size="boton" />
                      {p.municipio}
                    </p>
                  </div>
                </div>
                {p.placeholder && <span class="member__ejemplo">EJEMPLO</span>}
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="team__boton" data-appear style="--appear-delay:0.4s">
      <Btn label={boton.etiqueta} href={boton.href} />
    </div>
  </div>
</section>
<style>
  .team {
    position: relative;
    overflow: clip;
    padding-block: 80px;
  }
  .team :global(.team__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .team__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
    overflow: hidden;
  }
  .team__head {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .team__label {
    flex: 1;
  }
  .team__text {
    width: 460px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ticker {
    overflow: clip;
    border-radius: 10px;
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker var(--dur) linear infinite;
  }
  /* Se detiene mientras el cursor o el foco están en la fila (diseño §8: contenido en movimiento con pausa). */
  .ticker:hover .ticker__track,
  .ticker:focus-within .ticker__track {
    animation-play-state: paused;
  }
  .ticker__set {
    display: flex;
    gap: 20px;
    padding-right: 20px;
  }
  @keyframes ticker {
    to {
      transform: translateX(calc(-1 * var(--loop)));
    }
  }
  /* Movimiento reducido: la fila no se mueve, se desplaza con el dedo o el teclado, y se oculta la copia. */
  @media (prefers-reduced-motion: reduce) {
    .ticker {
      overflow-x: auto;
    }
    .ticker__track {
      animation: none;
    }
    .ticker__set[aria-hidden='true'] {
      display: none;
    }
  }

  .member {
    position: relative;
    display: block;
    width: 278px;
    height: 352px;
    flex: none;
    border-radius: 8px;
    overflow: clip;
    border: 1px solid var(--dx-linea-sobre-foto);
    background: color-mix(in srgb, var(--dx-negro) 15%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .member :global(.member__photo),
  .member__blur {
    position: absolute;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .member :global(.member__photo) {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .member__blur {
    inset: auto 0 0;
    height: 54px;
    background: color-mix(in srgb, var(--dx-negro) 15%, transparent);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
  .member:hover :global(.member__photo),
  .member:hover .member__blur,
  .member:focus-visible :global(.member__photo),
  .member:focus-visible .member__blur {
    opacity: 1;
  }
  .member__body {
    position: absolute;
    inset: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .member__name {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .member__meta {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .member__meta > :first-child {
    flex: 1;
  }
  .member__city {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .member__city :global(.icon) {
    width: 14px;
    height: 14px;
  }
  /* Etiqueta visible mientras el proyecto sea un ejemplo: amarillo sobre negro, el contraste de la marca. */
  .member__ejemplo {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--dx-amarillo);
    color: var(--dx-negro);
    font-family: var(--font-texto);
    font-size: var(--txt-chico);
    font-weight: 600;
    line-height: var(--lh-etiqueta);
  }
  .team__boton {
    display: flex;
  }
  /* Sin cursor que revele la foto (tablet, móvil o pantalla táctil), la foto se ve siempre. */
  @media (max-width: 1199.98px), (hover: none) {
    .member :global(.member__photo),
    .member__blur {
      opacity: 1;
    }
  }
  @media (max-width: 809.98px) {
    .team__head {
      flex-direction: column;
    }
    .team__text {
      width: 100%;
    }
  }
</style>
