---
import Icon from '../Icon.astro';
import { site } from '../../lib/site';
const { testimonials } = await site('home');
const n = testimonials.items.length;
---
<section class="reviews">
  <div class="container reviews__inner">
    <p class="t-caption2" data-appear>{testimonials.label}</p>
    <div class="reviews__slider" data-reviews>
      <div class="reviews__slides">
        {testimonials.items.map((r: any, i: number) => (
          <article class:list={['review', { 'is-active': i === 0 }]} data-review aria-hidden={i !== 0 ? 'true' : 'false'}>
            <div class="review__images">
              <div class="review__stack">
                <img class="review__img review__img--grow" src={r.images[0]} alt="" loading="lazy" />
                <img class="review__img review__img--small" src={r.images[1]} alt="" loading="lazy" />
              </div>
              <img class="review__img review__img--tall" src={r.images[2]} alt="" loading="lazy" />
            </div>
            <div class="review__content">
              <blockquote class="t-h5 review__quote">{r.quote}</blockquote>
              <div class="review__who">
                <p class="t-body-lg">{r.name}</p>
                <p class="review__loc t-caption"><Icon name="pin" class="c-negro" />{r.location}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="reviews__progress">
        <div class="reviews__bars">
          {testimonials.items.map((_: any, i: number) => (
            <button class:list={['reviews__bar', { 'is-active': i === 0 }]} type="button" aria-label={`Show review ${i + 1}`} data-review-bar><span></span></button>
          ))}
        </div>
        <p class="reviews__count">/{n}</p>
      </div>
    </div>
  </div>
</section>
<style>
  .reviews { background: var(--dx-blanco); padding-block: var(--esp-8); }
  .reviews__inner { display: flex; flex-direction: column; gap: var(--esp-7); overflow: clip; }
  .reviews__slider { width: 100%; display: flex; flex-direction: column; gap: var(--esp-4); }
  .reviews__slides { display: grid; }
  .review { grid-area: 1 / 1; display: flex; flex-direction: column; gap: var(--esp-5); visibility: hidden; }
  .review.is-active { visibility: visible; }
  .review__images { display: flex; gap: var(--esp-2); aspect-ratio: 4 / 3; overflow: clip; }
  .review__stack { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--esp-2); }
  .review__img { width: 100%; object-fit: cover; border-radius: var(--radio); min-height: 0; }
  .review__img--grow, .review__img--small { flex: 1 1 0; }
  .review__img--tall { flex: 1 1 0; min-width: 0; height: 100%; }
  .review__content { display: flex; flex-direction: column; justify-content: space-between; gap: var(--esp-5); }
  .review__who { display: flex; flex-direction: column; justify-content: flex-end; gap: var(--esp-2); }
  .review__loc { display: flex; align-items: center; gap: var(--esp-1); }
  .reviews__progress { display: flex; flex-direction: column; align-items: flex-end; gap: var(--esp-2); }
  .reviews__bars { width: 100%; display: flex; gap: var(--esp-2); }
  /* El botón mide 48 px de alto (área táctil); solo se ve la línea del centro. */
  .reviews__bar { flex: 1; padding-block: calc((var(--tactil) - var(--linea)) / 2); cursor: pointer; }
  .reviews__bar span { display: block; height: var(--linea); background: var(--dx-gris-claro); }
  .reviews__bar.is-active span { background: var(--dx-negro); }
  .reviews__count { font-family: var(--font-texto); font-weight: 600; font-size: var(--txt-chico); line-height: var(--lh-etiqueta); color: var(--dx-negro); }
  @media (min-width: 768px) {
    .review { flex-direction: row; align-items: center; gap: var(--medianil); }
    .review__images, .review__content { flex: 1 1 0; min-width: 0; }
  }
  @media (min-width: 1024px) { .reviews { padding-block: var(--esp-9); } }
</style>
