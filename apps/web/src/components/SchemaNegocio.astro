---
import { negocio, zonas } from '../lib/negocio';

// JSON-LD del negocio (reglas-seo sección 12).
// PROHIBIDO: address, streetAddress y geo. El negocio opera sin dirección pública.
const datos: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${negocio.url}/#negocio`,
  name: negocio.nombre,
  url: `${negocio.url}/`,
  telephone: negocio.telefono.tel,
  areaServed: zonas.todas.map((zona) => ({ '@type': 'City', name: zona })),
  logo: new URL(negocio.logo, negocio.url).href,
};
if (negocio.correo) datos.email = negocio.correo;
if (negocio.redes.length > 0) datos.sameAs = negocio.redes.map((r) => r.url);
---

<script type="application/ld+json" set:html={JSON.stringify(datos)} />
