---
import Btn from '../Btn.astro';
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import type { Foto as FotoDatos } from '../../lib/contenido/inicio';
import type { Proyecto } from '../../lib/contenido/proyectos';

// Fila de tarjetas de proyectos: el Team de la plantilla Marby, con proyectos en lugar de personas (foto, número,
// título, servicios como etiquetas, municipio con su ícono y un texto corto). Cada tarjeta enlaza a /proyectos/. Es el
// carrusel de proyectos de Nosotros y de las páginas de categoría: recibe la lista (Nosotros, todos; una categoría, los
// suyos), su título y la foto de fondo. Cada proyecto aparece UNA sola vez (sin copias): si las tarjetas caben en el
// ancho, se muestran fijas, sin avance ni arrastre; si lo exceden, la fila es un contenedor con scroll horizontal nativo
// que se desliza con el dedo, la rueda, el trackpad o arrastrando, y un pequeño script la hace avanzar a 50 px por segundo
// de ida y vuelta (al llegar a un extremo se detiene un momento y regresa), sin botón de pausa. El avance se detiene
// mientras la persona toca, arrastra, pasa el cursor o hace foco, y se reanuda 3 segundos después. Con movimiento reducido
// (o sin JavaScript) no avanza sola, pero se desliza a mano. Solo cambian los textos, los colores (tokens --dx-*), las
// tipografías y lo que exigen las reglas. La foto no depende del cursor en pantallas táctiles. La protección contra los
// ejemplos vive en content/proyectos.ts. Acomodo del bloque: con pocos proyectos fijos, TODO se centra en un mismo eje
// (etiqueta, título de ancho limitado, tarjetas y botón); en cuanto hay carrusel (`is-carrusel`, que pone el script),
// vuelve el acomodo original de la plantilla: etiqueta a la izquierda, título en su columna y botón al borde del contenedor.
interface Props {
  etiqueta: string;
  titulo: string;
  foto: FotoDatos;
  items: Proyecto[];
  boton: { etiqueta: string; href: string };
}
const { etiqueta, titulo, foto, items, boton } = Astro.props;
---

<section class="team sobre-negro" data-team>
  <Foto class="team__bg" src={foto.src} alt="" sizes="100vw" />
  <div class="container team__inner" data-appear style="--appear-y:0px">
    <div class="team__head">
      <p class="t-caption2 c-blanco team__label" data-appear>
        {etiqueta}
      </p>
      <div class="team__text">
        <h2 class="t-h2 c-blanco" data-appear style="--appear-delay:0.1s">
          {titulo}
        </h2>
      </div>
    </div>
    <div
      class="ticker"
      role="region"
      aria-label={titulo}
      tabindex="0"
      data-ticker
      data-appear
      style="--appear-delay:0.3s"
    >
      <div class="ticker__track">
        <div class="ticker__set">
          {items.map((p, i) => (
            <a class="member" href={boton.href} aria-label={`Ver proyectos: ${p.titulo}`}>
              <Foto class="member__photo" src={p.foto.src} alt={p.foto.alt} sizes="278px" widths={[278, 556, 834]} />
              <div class="member__blur" aria-hidden="true" />
              <div class="member__body">
                <div class="member__name">
                  <p class="t-caption c-blanco">{String(i + 1).padStart(2, '0')}</p>
                  <h3 class="t-h4 c-blanco">{p.titulo}</h3>
                  <p class="t-caption c-blanco">{p.texto}</p>
                </div>
                <div class="member__meta">
                  <p class="t-caption c-blanco">{p.servicios.join(' · ')}</p>
                  <p class="t-caption c-blanco member__city">
                    <Icon name="pin" size="boton" />
                    {p.municipio}
                  </p>
                </div>
              </div>
              {p.placeholder && <span class="member__ejemplo">EJEMPLO</span>}
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="team__boton" data-appear style="--appear-delay:0.4s">
      <Btn label={boton.etiqueta} href={boton.href} />
    </div>
    <script>
      // Hace avanzar la fila de proyectos cuando no caben en el ancho, y la deja deslizar a mano.
      const VELOCIDAD = 50; // px por segundo, como en la plantilla
      const ESPERA = 3000; // ms que el avance espera después de que la persona suelta
      const PAUSA_EXTREMO = 1500; // ms que la fila se detiene al llegar a un extremo antes de regresar
      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');

      document.querySelectorAll<HTMLElement>('[data-ticker]').forEach((fila) => {
        let desborda = false; // ¿las tarjetas exceden el ancho? Si no, la fila queda fija
        let direccion = 1;
        let pos = 0;
        let hover = false;
        let foco = false;
        let tocando = false;
        let arrastrando = false;
        let visible = false;
        let reanudaEn = 0;
        let ultimo = 0;
        let movido = 0;
        let inicioX = 0;
        let inicioScroll = 0;

        const esperar = () => (reanudaEn = performance.now() + ESPERA);
        const maximo = () => fila.scrollWidth - fila.clientWidth;
        // Solo hay carrusel si las tarjetas exceden el ancho; si caben, se muestran fijas (sin avance ni arrastre).
        const medir = () => {
          desborda = maximo() > 1;
          fila.classList.toggle('is-desborda', desborda);
          fila.closest('.team')?.classList.toggle('is-carrusel', desborda);
          if (desborda) {
            fila.setAttribute('tabindex', '0');
          } else {
            fila.removeAttribute('tabindex');
            fila.scrollLeft = 0;
            pos = 0;
          }
        };

        const cuadro = (t: number) => {
          requestAnimationFrame(cuadro);
          const dt = Math.min(t - ultimo, 100);
          ultimo = t;
          if (!desborda || !visible || reducido.matches) return;
          if (hover || foco || tocando || arrastrando || t < reanudaEn) {
            pos = fila.scrollLeft; // la persona mueve la fila: el avance sigue desde donde quedó
            return;
          }
          pos += (direccion * VELOCIDAD * dt) / 1000;
          const tope = maximo();
          if (pos >= tope) {
            pos = tope;
            direccion = -1;
            reanudaEn = t + PAUSA_EXTREMO;
          } else if (pos <= 0) {
            pos = 0;
            direccion = 1;
            reanudaEn = t + PAUSA_EXTREMO;
          }
          fila.scrollLeft = pos;
        };

        new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(fila);
        const observador = new ResizeObserver(medir);
        observador.observe(fila);
        observador.observe(fila.firstElementChild!); // la pista cambia de ancho si cambia su contenido
        medir();
        ultimo = performance.now();
        requestAnimationFrame(cuadro);

        // Mientras la persona usa la fila, el avance se detiene.
        fila.addEventListener('mouseenter', () => (hover = true));
        fila.addEventListener('mouseleave', () => {
          hover = false;
          esperar();
        });
        fila.addEventListener('focusin', () => (foco = true));
        fila.addEventListener('focusout', () => {
          foco = false;
          esperar();
        });
        fila.addEventListener('touchstart', () => (tocando = true), { passive: true });
        const soltar = () => {
          tocando = false;
          esperar();
        };
        fila.addEventListener('touchend', soltar);
        fila.addEventListener('touchcancel', soltar);
        fila.addEventListener('wheel', esperar, { passive: true });
        fila.addEventListener('keydown', esperar);

        // Arrastre con el mouse (con el dedo, el navegador ya desliza solo). Solo si hay algo que deslizar.
        fila.addEventListener('pointerdown', (e) => {
          if (!desborda || e.pointerType !== 'mouse' || e.button !== 0) return;
          arrastrando = true;
          movido = 0;
          inicioX = e.clientX;
          inicioScroll = fila.scrollLeft;
          fila.classList.add('is-arrastrando');
          const mover = (m: PointerEvent) => {
            const dx = m.clientX - inicioX;
            movido = Math.max(movido, Math.abs(dx));
            fila.scrollLeft = inicioScroll - dx;
          };
          const terminar = () => {
            arrastrando = false;
            fila.classList.remove('is-arrastrando');
            esperar();
            removeEventListener('pointermove', mover);
            removeEventListener('pointerup', terminar);
            removeEventListener('pointercancel', terminar);
          };
          addEventListener('pointermove', mover);
          addEventListener('pointerup', terminar);
          addEventListener('pointercancel', terminar);
        });
        // Si la persona arrastró, soltar no cuenta como clic en la tarjeta.
        fila.addEventListener(
          'click',
          (e) => {
            if (movido > 5) {
              e.preventDefault();
              e.stopPropagation();
            }
            movido = 0;
          },
          true,
        );
        fila.addEventListener('dragstart', (e) => e.preventDefault());
      });
    </script>
  </div>
</section>
<style>
  .team {
    position: relative;
    overflow: clip;
    padding-block: 80px;
  }
  .team :global(.team__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .team__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
    overflow: hidden;
  }
  /* Pocos proyectos fijos (sin carrusel): etiqueta, título, tarjetas y botón comparten el eje central. */
  .team__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .team__text {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .team__boton {
    display: flex;
    justify-content: center;
  }
  /* Carrusel: el acomodo original de la plantilla, alineado al contenedor. */
  @media (min-width: 810px) {
    .team.is-carrusel .team__head {
      flex-direction: row;
      align-items: flex-start;
    }
    .team.is-carrusel .team__label {
      flex: 1;
    }
    .team.is-carrusel .team__text {
      width: 460px;
      max-width: none;
    }
  }
  .team.is-carrusel .team__head {
    text-align: left;
  }
  .team.is-carrusel .team__boton {
    justify-content: flex-start;
  }
  /* Contenedor con scroll horizontal nativo. Si las tarjetas caben, se ven fijas; si lo exceden (`is-desborda`), avanza
     solo (script) y se desliza a mano. Sin barra visible. */
  .ticker {
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: 10px;
    -webkit-user-select: none;
    user-select: none;
  }
  .ticker.is-desborda {
    cursor: grab;
  }
  .ticker::-webkit-scrollbar {
    display: none;
  }
  .ticker.is-arrastrando {
    cursor: grabbing;
  }
  /* Si las tarjetas caben en el ancho, se ven fijas y CENTRADAS (la pista mide al menos todo el ancho); si lo exceden, la
     pista mide lo que mide su contenido y el contenedor se desliza (el centrado no recorta el inicio). */
  .ticker__track {
    display: flex;
    width: max-content;
    min-width: 100%;
    justify-content: center;
  }
  .ticker__set {
    display: flex;
    gap: 20px;
  }

  .member {
    position: relative;
    display: block;
    width: 278px;
    height: 352px;
    flex: none;
    border-radius: 8px;
    overflow: clip;
    border: 1px solid var(--dx-linea-sobre-foto);
    background: color-mix(in srgb, var(--dx-negro) 15%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit-user-drag: none;
  }
  .member :global(.member__photo),
  .member__blur {
    position: absolute;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .member :global(.member__photo) {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .member__blur {
    inset: auto 0 0;
    height: 54px;
    background: color-mix(in srgb, var(--dx-negro) 15%, transparent);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
  .member:hover :global(.member__photo),
  .member:hover .member__blur,
  .member:focus-visible :global(.member__photo),
  .member:focus-visible .member__blur {
    opacity: 1;
  }
  .member__body {
    position: absolute;
    inset: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .member__name {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .member__meta {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .member__meta > :first-child {
    flex: 1;
  }
  .member__city {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .member__city :global(.icon) {
    width: 14px;
    height: 14px;
  }
  /* Etiqueta visible mientras el proyecto sea un ejemplo: amarillo sobre negro, el contraste de la marca. */
  .member__ejemplo {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--dx-amarillo);
    color: var(--dx-negro);
    font-family: var(--font-texto);
    font-size: var(--txt-chico);
    font-weight: 600;
    line-height: var(--lh-etiqueta);
  }
  /* Sin cursor que revele la foto (tablet, móvil o pantalla táctil), la foto se ve siempre. */
  @media (max-width: 1199.98px), (hover: none) {
    .member :global(.member__photo),
    .member__blur {
      opacity: 1;
    }
  }
  @media (max-width: 809.98px) {
    .team.is-carrusel .team__head {
      align-items: flex-start;
    }
    .team.is-carrusel .team__text {
      width: 100%;
      max-width: none;
    }
  }
</style>
