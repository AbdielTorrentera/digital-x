---
import Icon from '../Icon.astro';
interface Props {
  n: number;
  q: string;
  a: string;
}
const { n, q, a } = Astro.props;
const id = `tile-${n}`;
---

<!-- "Question card 2": a tile that turns dark and reveals the answer. -->
<div class="qtile" data-acc-item data-acc-trigger data-appear>
  <div class="qtile__top">
    <span class="t-h1 qtile__n">{String(n).padStart(2, '0')}</span>
    <button class="qtile__btn" type="button" aria-expanded="false" aria-controls={id} aria-label={q}>
      <Icon name="plus" size="boton" />
    </button>
  </div>
  <div class="qtile__body">
    <h3 class="t-h6 qtile__q">{q}</h3>
    <p class="t-body qtile__a" id={id}>
      {a}
    </p>
  </div>
</div>
<style>
  .qtile {
    padding: var(--esp-4);
    border-radius: var(--radio);
    background: var(--dx-gris-claro);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--esp-7);
    overflow: hidden;
    cursor: pointer;
  }
  .qtile__top {
    display: flex;
    align-items: flex-start;
    gap: var(--esp-2);
  }
  .qtile__n {
    flex: 1;
  }
  .qtile__btn {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--tactil);
    height: var(--tactil);
    border-radius: var(--radio);
    background: var(--dx-negro);
    color: var(--dx-blanco);
  }
  .qtile__btn :global(.icon) {
    transition: transform var(--dur-media) var(--ease);
  }
  .qtile__body {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
  }
  .qtile__a {
    display: none;
    color: var(--dx-blanco);
  }
  .qtile.is-open {
    background: var(--dx-negro);
  }
  .qtile.is-open .qtile__n {
    color: var(--dx-blanco);
  }
  .qtile.is-open .qtile__q {
    color: var(--dx-blanco);
  }
  .qtile.is-open .qtile__a {
    display: block;
  }
  .qtile.is-open .qtile__btn :global(.icon) {
    transform: rotate(45deg);
  }
  @media (min-width: 1024px) {
    .qtile {
      padding: var(--esp-5);
    }
  }
</style>
