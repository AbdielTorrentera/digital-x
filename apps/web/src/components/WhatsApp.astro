---
import Icon from './Icon.astro';
import { waUrl } from '../lib/negocio';

// Botón flotante de WhatsApp (reglas-seo sección 11): solo ícono, en todos los tamaños, en un círculo igual al de
// llamada. El mensaje prellenado cambia por página. Su posición fija la da Flotantes.astro, que lo apila con el
// botón de llamada.
interface Props {
  mensaje?: string;
}
const { mensaje } = Astro.props;
---

<a
  class="wa"
  href={waUrl(mensaje)}
  target="_blank"
  rel="noopener"
  aria-label="Cotizar por WhatsApp (se abre en una pestaña nueva)"
>
  <Icon name="whatsapp" size="flotante" />
</a>
<style>
  .wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--boton-flotante);
    height: var(--boton-flotante);
    border-radius: var(--radio-pildora);
    /* Verde de WhatsApp (#1D9446) con el logo clásico en línea blanca (Phosphor Bold): 3.91:1, cumple 3:1 para gráficos. */
    background: var(--dx-whatsapp);
    color: var(--dx-blanco);
    box-shadow: var(--sombra-flotante);
  }
  .wa:active {
    transform: translateY(var(--linea));
  }
  /* Sobre el pie negro el contorno negro no se ve: un halo blanco en la separación de 2 px lo marca. */
  .wa:focus-visible {
    outline-color: var(--dx-negro);
    box-shadow:
      0 0 0 var(--foco) var(--dx-blanco),
      var(--sombra-flotante);
  }
</style>
