---
import Btn from './Btn.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { negocio, waUrl } from '../lib/negocio';
import { menu } from '../lib/paginas';

const actual = Astro.url.pathname;
const retardos = [0.15, 0.15, 0.25, 0.35, 0.45];
---

<!--
  Menú de la plantilla Marby, tal cual. Barra fija y translúcida (blanco al 85 % con desenfoque, para que lo que pasa por
  detrás no estorbe al logo), con el botón (chip negro, solo ícono) que abre un panel claro a pantalla completa: arriba
  la marca y la X, enlaces grandes y centrados con entrada escalonada, y debajo las redes (solo si existen) y "Cotizar
  por WhatsApp". El logo de Digital X ocupa el lugar del texto de Marby y, igual que el botón, es siempre negro. Se
  quitaron el botón de consulta de la barra y el "clic en cualquier parte abre el menú" (accesibilidad). Solo cambian los
  textos, los colores, las tipografías y lo que exigen las reglas.
-->
<header class="nav" data-nav>
  <div class="nav__bar">
    <div class="nav__col nav__col--menu">
      <button
        class="chip"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-open
      >
        <Icon name="menu" size="boton" />
      </button>
    </div>
    <a class="nav__col nav__col--tag" href="/" aria-label="Digital X, inicio">
      <span class="nav__tag">
        <Logo />
      </span>
    </a>
    <div class="nav__col nav__col--cta" aria-hidden="true"></div>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menú principal" hidden data-menu>
  <div class="menu__top">
    <div class="menu__brand">
      <button class="chip" type="button" aria-label="Cerrar menú" data-menu-close>
        <Icon name="close" size="boton" />
      </button>
      <a class="menu__logo" href="/" aria-label="Digital X, inicio">
        <Logo />
      </a>
    </div>
    <div class="menu__top-cta">
      <Btn
        label="Cotizar por WhatsApp"
        href={waUrl()}
        target="_blank"
        rel="noopener"
        aria-label="Cotizar por WhatsApp (se abre en una pestaña nueva)"
      />
    </div>
  </div>
  <nav class="menu__list" aria-label="Principal">
    {menu.map((item, i) => (
      <a
        class="menu__item t-h2"
        href={item.url}
        aria-current={actual === item.url ? 'page' : undefined}
        style={`--d:${retardos[i] ?? 0.45}s`}
      >
        {item.titulo}
      </a>
    ))}
    {negocio.redes.length > 0 && (
      <div class="menu__socials" style="--d:0.55s">
        {negocio.redes.map((r) => (
          <a class="menu__social t-caption2" href={r.url} target="_blank" rel="noopener">
            {r.nombre}
            <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
          </a>
        ))}
      </div>
    )}
    <div class="menu__bottom-cta">
      <Btn
        label="Cotizar por WhatsApp"
        href={waUrl()}
        target="_blank"
        rel="noopener"
        aria-label="Cotizar por WhatsApp (se abre en una pestaña nueva)"
      />
    </div>
  </nav>
</div>

<style>
  /* Blanco translúcido con desenfoque; la línea inferior (dentro del alto, sin sumarle) separa la barra del contenido.
     Sin soporte de backdrop-filter, blanco casi opaco. El panel del menú no es hijo de la barra: no le afecta. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--dx-blanco) 85%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 -1px 0 var(--dx-gris-claro);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav {
      background: color-mix(in srgb, var(--dx-blanco) 95%, transparent);
    }
  }
  .nav__bar {
    max-width: 1240px;
    margin-inline: auto;
    padding: 20px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .nav__col {
    flex: 1 1 0;
    display: flex;
  }
  .nav__col--tag {
    position: relative;
    justify-content: center;
  }
  /* Zona de toque del logo de al menos 48 px de alto, sin cambiar su tamaño visible. */
  .nav__col--tag::after {
    content: '';
    position: absolute;
    inset: calc((var(--tactil) - 100%) / -2) 0;
  }
  .nav__col--cta {
    justify-content: flex-end;
  }
  .nav__tag {
    text-align: center;
    color: var(--dx-negro);
  }

  .chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--dx-negro);
    color: var(--dx-blanco);
    cursor: pointer;
  }
  /* Zona de toque de 48 × 48 px, centrada y sin efecto visual (diseño §6, SEO §10). */
  .chip::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--tactil);
    height: var(--tactil);
    transform: translate(-50%, -50%);
  }
  .chip :global(.icon) {
    width: 16px;
    height: 16px;
  }
  /* Sin JavaScript el panel no se puede abrir: el botón no se muestra y la navegación queda en el pie. */
  :global(html:not(.js)) [data-menu-open] {
    display: none;
  }

  @media (max-width: 809.98px) {
    .nav__bar {
      align-items: center;
      justify-content: space-between;
    }
    .nav__col--menu {
      order: 2;
      justify-content: flex-end;
    }
    .nav__col--tag {
      order: 1;
      justify-content: flex-start;
    }
    .nav__tag {
      width: 100%;
      text-align: left;
    }
    .nav__col--cta {
      display: none;
    }
  }

  /* ---------- panel del menú ---------- */
  /* Por encima de los botones flotantes (z 20) para que el panel abierto los cubra. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: var(--dx-gris-claro);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__top {
    position: absolute;
    inset: 0 0 auto 0;
    max-width: 1160px;
    margin-inline: auto;
    padding: 20px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }
  .menu__brand {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .menu__logo {
    position: relative;
    display: inline-flex;
    color: var(--dx-negro);
  }
  .menu__logo::after {
    content: '';
    position: absolute;
    inset: calc((var(--tactil) - 100%) / -2) 0;
  }
  .menu__list {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding-block: 90px;
    opacity: 0;
    transform: scale(0.98);
  }
  .menu.is-open .menu__list {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--spring-05-dur) var(--spring-05),
      transform var(--spring-05-dur) var(--spring-05);
  }
  .menu__item {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
    color: var(--dx-negro);
    border-bottom: 1px solid transparent;
    transition:
      padding var(--spring-04-dur) var(--spring-04),
      color var(--spring-04-dur) var(--spring-04),
      border-color var(--spring-04-dur) var(--spring-04);
  }
  /* Zona de toque de al menos 48 px de alto, sin cambiar el tamaño ni el espaciado del original. */
  .menu__item::after {
    content: '';
    position: absolute;
    inset: calc((var(--tactil) - 100%) / -2) -8px;
  }
  .menu__item,
  .menu__socials {
    opacity: 0;
    transform: translateY(20px);
  }
  .menu__socials {
    transform: translateY(10px);
  }
  .menu.is-open .menu__item,
  .menu.is-open .menu__socials {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--spring-055-dur) var(--spring-055) var(--d),
      transform var(--spring-055-dur) var(--spring-055) var(--d),
      padding var(--spring-04-dur) var(--spring-04),
      color var(--spring-04-dur) var(--spring-04),
      border-color var(--spring-04-dur) var(--spring-04);
  }
  .menu__item[aria-current='page'] {
    border-color: var(--dx-negro);
  }
  @media (hover: hover) and (min-width: 810px) {
    .menu__item:hover {
      padding-left: 12px;
      border-color: var(--dx-negro);
    }
  }
  .menu__socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 20px;
  }
  /* Las redes ocupan 48 px de alto de verdad (no solo de zona de toque): entre sí quedarían zonas encimadas. */
  .menu__social {
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
    color: var(--dx-negro);
  }
  .menu__social:hover {
    text-decoration: underline;
  }
  .menu__bottom-cta {
    display: none;
  }

  @media (max-width: 809.98px) {
    .menu__top {
      padding: 16px;
    }
    .menu__brand {
      flex: 1;
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: center;
    }
    .menu__top-cta {
      display: none;
    }
    .menu__list {
      padding-left: 20px;
    }
    .menu__bottom-cta {
      display: flex;
    }
  }
</style>
