---
import QuestionRow from '../ui/QuestionRow.astro';
import { faqPageJsonLd, serializarJsonLd, type PreguntaFrecuente } from '../../lib/jsonld';

// Preguntas frecuentes. El FAQPage (JSON-LD) se genera de la misma lista que se muestra, así nunca difieren
// (reglas-seo sección 12: solo en páginas que muestran las preguntas en pantalla).
interface Props {
  etiqueta: string;
  titulo: string;
  texto: string;
  items: PreguntaFrecuente[];
}
const { etiqueta, titulo, texto, items } = Astro.props;
---

<section class="faq">
  <div class="container faq__inner">
    <div class="faq__head">
      <div class="faq__title">
        <p class="t-caption2">{etiqueta}</p>
        <h2 class="t-h2">{titulo}</h2>
      </div>
      <div class="faq__side">
        <p class="t-body">{texto}</p>
      </div>
    </div>
    <div class="faq__list" data-accordion>
      {items.map((item, i) => (
        <QuestionRow n={i + 1} q={item.pregunta} a={item.respuesta} />
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={serializarJsonLd(faqPageJsonLd(items))} />
</section>
<style>
  .faq {
    background: var(--dx-gris-claro);
    padding-block: var(--esp-8);
  }
  .faq__inner {
    display: flex;
    flex-direction: column;
    gap: var(--esp-7);
  }
  .faq__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-5);
  }
  .faq__title {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
  }
  .faq__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
  }
  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--esp-5);
  }
  @media (min-width: 1024px) {
    .faq {
      padding-block: var(--esp-9);
    }
    .faq__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .faq__title,
    .faq__side {
      flex: 1 1 0;
    }
  }
</style>
