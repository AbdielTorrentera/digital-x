---
import type { TextoConEnlaces } from '../../content/servicios';
import { enlaceAPagina } from '../../lib/enlaces';
import { enlaceDeServicio } from '../../lib/servicios';

// Un texto corrido con enlaces: la nota bajo "Qué incluye", los párrafos y los puntos con título de las secciones. Un trozo
// de texto se escribe tal cual; un `{ slug, texto }` es un enlace a la página del servicio si está publicada o, si no, a
// su tarjeta del catálogo (/servicios/#slug); un `{ url, texto }` es un enlace a otra página del registro (validada con
// `enlaceAPagina`). Un texto sin enlaces puede ser un `string`.
interface Props {
  texto: string | TextoConEnlaces;
}
const { texto } = Astro.props;
const trozos = typeof texto === 'string' ? [texto] : texto;
---

{trozos.map((trozo) =>
  typeof trozo === 'string' ? (
    trozo
  ) : (
    <a class="link" href={'slug' in trozo ? enlaceDeServicio(trozo.slug) : enlaceAPagina(trozo.url)}>
      {trozo.texto}
    </a>
  ),
)}
