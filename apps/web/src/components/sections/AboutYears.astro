---
// Prólogo y línea de tiempo: AboutYears de la plantilla Marby. Cada hito trae una sola frase, así que ya no se
// intercambian título y texto al pasar el cursor (era para dos textos) y la frase se ve siempre. Con 3 hitos la
// cuadrícula de tablet es de 3 columnas, para que no quede un hueco. Medidas, de la plantilla.
interface Hito {
  anio: string;
  texto: string;
}
interface Props {
  etiqueta: string;
  texto: string;
  hitos: Hito[];
}
const { etiqueta, texto, hitos } = Astro.props;
---

<section class="years">
  <div class="years__inner">
    <div class="years__head">
      <p class="t-caption2 years__label" data-appear>
        {etiqueta}
      </p>
      <p class="t-body years__text" data-appear style="--appear-delay:0.1s">
        {texto}
      </p>
    </div>
    <ul class="years__row">
      {hitos.map((h, i) => (
        <li class="mcard" data-appear style={`--appear-delay:${0.2 + i * 0.1}s`}>
          <p class="t-body mcard__text">{h.texto}</p>
          <p class="t-h2">{h.anio}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .years {
    background: var(--dx-blanco);
    padding: 80px 20px;
  }
  .years__inner {
    max-width: 1240px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .years__head {
    display: flex;
    gap: 20px;
  }
  .years__label {
    flex: 1;
  }
  .years__text {
    flex: 1;
    max-width: 460px;
  }
  .years__row {
    display: flex;
    gap: 20px;
  }
  .mcard {
    flex: 1 1 0;
    min-width: 0;
    height: 230px;
    padding: 20px;
    border-radius: 8px;
    background: var(--dx-gris-claro);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    overflow: hidden;
  }
  .mcard__text {
    padding-bottom: 20px;
    box-shadow: inset 0 -1px 0 var(--dx-gris-medio);
  }
  .mcard > .t-h2 {
    margin-top: auto;
  }
  @media (max-width: 1199.98px) {
    .years {
      padding-block: 40px;
    }
    .years__row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 809.98px) {
    .years__head {
      flex-direction: column;
    }
    .years__text {
      max-width: none;
    }
    .years__row {
      display: flex;
      flex-direction: column;
    }
    .mcard {
      flex: none;
      width: 100%;
    }
  }
</style>
