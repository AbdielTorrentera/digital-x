---
import Btn from './Btn.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { negocio, waUrl } from '../lib/negocio';
import { destinoDeCategoria, menu, paginas } from '../lib/paginas';

const actual = Astro.url.pathname;
const retardos = [0.15, 0.15, 0.25, 0.35, 0.45];
// La entrada de la página actual lleva aria-current="page"; la de la categoría de un servicio, aria-current="true" (la
// sección en la que estás). Un servicio de Audio, que es el único de su categoría, es la página exacta de la entrada Audio.
const servicioActual = paginas.find((p) => p.categoria && p.url === actual);
const destinoActual = servicioActual?.categoria ? destinoDeCategoria(servicioActual.categoria) : null;
const estado = (url: string) => (actual === url ? 'page' : destinoActual === url ? 'true' : undefined);
---

<!--
  Menú de la plantilla Marby: barra fija NEGRA con el logo blanco (identidad §1) y, desde 1024 px, el menú a la vista en
  la barra (Inicio · categorías · Nosotros…) con la página actual subrayada. Debajo de 1024 px, el botón (chip blanco con
  el ícono negro, para contrastar sobre negro) abre el panel claro a pantalla completa: arriba la marca y la X, enlaces
  grandes y centrados con entrada escalonada, y debajo las redes (solo si existen) y "Cotizar por WhatsApp". Las
  entradas salen de la misma lista (lib/paginas.ts, `menu`) en la barra y en el panel. Solo el botón abre el panel (no
  toda la barra: accesibilidad). Solo cambian los textos, los colores, las tipografías y lo que exigen las reglas.
-->
<header class="nav sobre-negro" data-nav>
  <div class="nav__bar">
    <a class="nav__logo" href="/" aria-label="Digital X, inicio">
      <Logo />
    </a>
    <nav class="nav__menu" aria-label="Principal">
      <ul class="nav__lista">
        {menu.map((item) => (
          <li>
            <a class="nav__enlace t-body-sm" href={item.url} aria-current={estado(item.url)}>
              {item.titulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button
      class="chip chip--claro"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-open
    >
      <Icon name="menu" size="boton" />
    </button>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menú principal" hidden data-menu>
  <div class="menu__top">
    <div class="menu__brand">
      <button class="chip" type="button" aria-label="Cerrar menú" data-menu-close>
        <Icon name="close" size="boton" />
      </button>
      <a class="menu__logo" href="/" aria-label="Digital X, inicio">
        <Logo />
      </a>
    </div>
    <div class="menu__top-cta">
      <Btn
        label="Cotizar por WhatsApp"
        href={waUrl()}
        target="_blank"
        rel="noopener"
        aria-label="Cotizar por WhatsApp (se abre en una pestaña nueva)"
      />
    </div>
  </div>
  <nav class="menu__list" aria-label="Principal">
    {menu.map((item, i) => (
      <a class="menu__item t-h2" href={item.url} aria-current={estado(item.url)} style={`--d:${retardos[i] ?? 0.45}s`}>
        {item.titulo}
      </a>
    ))}
    {negocio.redes.length > 0 && (
      <div class="menu__socials" style="--d:0.55s">
        {negocio.redes.map((r) => (
          <a class="menu__social t-caption2" href={r.url} target="_blank" rel="noopener">
            {r.nombre}
            <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
          </a>
        ))}
      </div>
    )}
    <div class="menu__bottom-cta">
      <Btn
        label="Cotizar por WhatsApp"
        href={waUrl()}
        target="_blank"
        rel="noopener"
        aria-label="Cotizar por WhatsApp (se abre en una pestaña nueva)"
      />
    </div>
  </nav>
</div>

<style>
  /* Barra negra, fija y sin translucidez (la clase sobre-negro pone el fondo, el texto blanco y el foco amarillo). El
     panel del menú no es hijo de la barra: no le afecta. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .nav__bar {
    max-width: 1240px;
    margin-inline: auto;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .nav__logo {
    position: relative;
    display: inline-flex;
    color: var(--dx-blanco);
  }
  /* Zona de toque del logo de al menos 48 px de alto, sin cambiar su tamaño visible. */
  .nav__logo::after {
    content: '';
    position: absolute;
    inset: calc((var(--tactil) - 100%) / -2) 0;
  }
  /* El menú de la barra solo se muestra desde 1024 px (escritorio, diseño §1): cabe completo con el logo y con Blog. */
  .nav__menu {
    display: none;
  }
  .nav__lista {
    display: flex;
    align-items: center;
    gap: 4px 28px;
  }
  .nav__enlace {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--dx-blanco);
    text-underline-offset: 8px;
    text-decoration-thickness: 2px;
  }
  /* Zona de toque de al menos 48 px de alto, sin cambiar el tamaño de la letra. */
  .nav__enlace::after {
    content: '';
    position: absolute;
    inset: calc((var(--tactil) - 100%) / -2) -8px;
  }
  /* La página actual (y la sección en la que estás) se marca con subrayado, no solo con color (diseño §7). */
  .nav__enlace[aria-current] {
    text-decoration-line: underline;
  }
  @media (hover: hover) {
    .nav__enlace:hover {
      text-decoration-line: underline;
    }
  }
  @media (min-width: 1024px) {
    .nav__menu {
      display: block;
    }
    .nav__bar [data-menu-open] {
      display: none;
    }
  }

  /* Botón del panel: chip negro sobre el panel claro; en la barra negra pasa a blanco con el ícono negro (21:1). */
  .chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--dx-negro);
    color: var(--dx-blanco);
    cursor: pointer;
  }
  .chip--claro {
    background: var(--dx-blanco);
    color: var(--dx-negro);
  }
  /* Zona de toque de 48 × 48 px, centrada y sin efecto visual (diseño §6, SEO §10). */
  .chip::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--tactil);
    height: var(--tactil);
    transform: translate(-50%, -50%);
  }
  .chip :global(.icon) {
    width: 16px;
    height: 16px;
  }
  /* Sin JavaScript el panel no se puede abrir: el botón no se muestra y la navegación queda en el pie. */
  :global(html:not(.js)) [data-menu-open] {
    display: none;
  }

  /* ---------- panel del menú ---------- */
  /* Por encima de los botones flotantes (z 20) para que el panel abierto los cubra. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: var(--dx-gris-claro);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__top {
    position: absolute;
    inset: 0 0 auto 0;
    max-width: 1160px;
    margin-inline: auto;
    padding: 20px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }
  .menu__brand {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .menu__logo {
    position: relative;
    display: inline-flex;
    color: var(--dx-negro);
  }
  .menu__logo::after {
    content: '';
    position: absolute;
    inset: calc((var(--tactil) - 100%) / -2) 0;
  }
  .menu__list {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding-block: 90px;
    opacity: 0;
    transform: scale(0.98);
  }
  .menu.is-open .menu__list {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--spring-05-dur) var(--spring-05),
      transform var(--spring-05-dur) var(--spring-05);
  }
  .menu__item {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
    color: var(--dx-negro);
    border-bottom: 1px solid transparent;
    transition:
      padding var(--spring-04-dur) var(--spring-04),
      color var(--spring-04-dur) var(--spring-04),
      border-color var(--spring-04-dur) var(--spring-04);
  }
  /* Zona de toque de al menos 48 px de alto, sin cambiar el tamaño ni el espaciado del original. */
  .menu__item::after {
    content: '';
    position: absolute;
    inset: calc((var(--tactil) - 100%) / -2) -8px;
  }
  .menu__item,
  .menu__socials {
    opacity: 0;
    transform: translateY(20px);
  }
  .menu__socials {
    transform: translateY(10px);
  }
  .menu.is-open .menu__item,
  .menu.is-open .menu__socials {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--spring-055-dur) var(--spring-055) var(--d),
      transform var(--spring-055-dur) var(--spring-055) var(--d),
      padding var(--spring-04-dur) var(--spring-04),
      color var(--spring-04-dur) var(--spring-04),
      border-color var(--spring-04-dur) var(--spring-04);
  }
  .menu__item[aria-current='page'] {
    border-color: var(--dx-negro);
  }
  @media (hover: hover) and (min-width: 810px) {
    .menu__item:hover {
      padding-left: 12px;
      border-color: var(--dx-negro);
    }
  }
  .menu__socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 20px;
  }
  /* Las redes ocupan 48 px de alto de verdad (no solo de zona de toque): entre sí quedarían zonas encimadas. */
  .menu__social {
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
    color: var(--dx-negro);
  }
  .menu__social:hover {
    text-decoration: underline;
  }
  .menu__bottom-cta {
    display: none;
  }

  @media (max-width: 809.98px) {
    .menu__top {
      padding: 16px;
    }
    .menu__brand {
      flex: 1;
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: center;
    }
    .menu__top-cta {
      display: none;
    }
    .menu__list {
      padding-left: 20px;
    }
    .menu__bottom-cta {
      display: flex;
    }
  }
</style>
