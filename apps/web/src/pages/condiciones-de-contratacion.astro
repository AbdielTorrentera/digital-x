---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import { actualizacion, dudas, intro, pagina, secciones } from '../content/condiciones';
import { mensajesWhatsApp } from '../lib/negocio';
---

<!-- Estructura: docs/estructura-sitio-digitalx.md sección 5. Metadatos y H1: docs/reglas-seo-digitalx.md sección 1. -->
<Base title={pagina.title} description={pagina.descripcion} whatsapp={mensajesWhatsApp.general}>
  <PageHeader label={pagina.etiqueta} title={pagina.h1} />
  <section class="condiciones">
    <div class="container">
      <div class="prose">
        <p>{intro}</p>
        {secciones.map((seccion) => (
          <>
            <h2>{seccion.titulo}</h2>
            {seccion.bloques.map((b) =>
              'parrafo' in b ? (
                <p>{b.parrafo}</p>
              ) : (
                <ul>
                  {b.lista.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              ),
            )}
            {seccion.subsecciones?.map((sub) => (
              <>
                <h3>{sub.titulo}</h3>
                {sub.bloques.map((b) =>
                  'parrafo' in b ? (
                    <p>{b.parrafo}</p>
                  ) : (
                    <ul>
                      {b.lista.map((i) => (
                        <li>{i}</li>
                      ))}
                    </ul>
                  ),
                )}
              </>
            ))}
          </>
        ))}
        <h2>{dudas.titulo}</h2>
        <p>
          {dudas.antes}
          <a href={dudas.whatsapp.href}>{dudas.whatsapp.texto}</a>
          {dudas.medio}
          <a href={dudas.llamar.href}>{dudas.llamar.texto}</a>
          {dudas.despues}
        </p>
        <p class="t-body-sm condiciones__fecha">
          Última actualización: <time datetime={actualizacion.iso}>{actualizacion.texto}</time>
        </p>
      </div>
    </div>
  </section>
</Base>
<style>
  .condiciones {
    background: var(--dx-blanco);
    padding: 0 0 var(--esp-9);
  }
  /* Los enlaces del texto: subrayados, y con zona de toque de 48 px sin mover las líneas. */
  .condiciones :global(.prose a) {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
  }
  .condiciones__fecha {
    margin-top: var(--esp-7);
  }
</style>
