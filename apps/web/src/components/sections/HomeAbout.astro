---
import Btn from '../Btn.astro';
import Foto from '../Foto.astro';
import type { Foto as FotoDatos } from '../../content/inicio';

// "About us" de la plantilla Marby: etiqueta, foto a la izquierda, título grande y texto a la derecha, y un botón. SIN
// las tres tarjetas de cifras de la plantilla (no hay datos y no se inventan números). Los textos vienen de
// content/inicio.ts (`queHacemos`).
interface Props {
  etiqueta: string;
  titulo: string;
  texto: string;
  foto: FotoDatos;
  boton: { etiqueta: string; href: string };
}
const { etiqueta, titulo, texto, foto, boton } = Astro.props;
---

<section class="about section">
  <div class="container about__inner">
    <div class="about__col">
      <p class="t-caption2" data-appear>
        {etiqueta}
      </p>
      <Foto class="about__img" src={foto.src} alt={foto.alt} sizes="(min-width: 1024px) 50vw, 100vw" />
    </div>
    <div class="about__col about__col--text">
      <h2 class="t-h2" data-appear>
        {titulo}
      </h2>
      <p class="t-body" data-appear>
        {texto}
      </p>
      <div data-appear>
        <Btn label={boton.etiqueta} href={boton.href} />
      </div>
    </div>
  </div>
</section>
<style>
  .about {
    background: var(--dx-blanco);
    /* Esta sección y la de servicios son blancas: el espacio entre ambas es el de una sola, no la suma de dos. */
    padding-block: var(--esp-8) 0;
  }
  .about__inner {
    display: flex;
    flex-direction: column;
    gap: var(--esp-5);
  }
  .about__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
  }
  /* <picture> no pinta caja: el <img> es el elemento del flujo. Picture no le pone al <img> el atributo de alcance. */
  .about :global(picture) {
    display: contents;
  }
  .about :global(.about__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radio);
  }
  @media (min-width: 1024px) {
    .about {
      padding-block: var(--esp-9) 0;
    }
    .about__inner {
      flex-direction: row;
      gap: var(--medianil);
    }
    .about__col {
      flex: 1 1 0;
      min-width: 0;
    }
  }
</style>
