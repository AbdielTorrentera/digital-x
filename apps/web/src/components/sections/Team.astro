---
import Btn from '../Btn.astro';
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import type { Foto as FotoDatos } from '../../content/inicio';
import type { Proyecto } from '../../content/proyectos';

// Fila de tarjetas que avanza sola: el Team de la plantilla Marby, con proyectos en lugar de personas (foto, número,
// título, servicios como etiquetas, municipio con su ícono y un texto corto). Cada tarjeta enlaza a /proyectos/.
// Solo cambian los textos, los colores (tokens --dx-*), las tipografías y lo que exigen las reglas. En lugar de una
// animación CSS (que no deja deslizar), la fila es un contenedor con scroll horizontal nativo que un pequeño script
// hace avanzar a 50 px por segundo, como la plantilla: se desliza con el dedo, la rueda, el trackpad o arrastrando, y
// el avance se detiene mientras la persona toca, arrastra, pasa el cursor o hace foco, y se reanuda 3 segundos
// después. El ciclo es continuo (la fila se repite las veces necesarias y el script salta entre copias idénticas). Las copias
// quedan fuera del foco y de los lectores de pantalla. Con movimiento reducido no avanza sola, pero se desliza a
// mano. La foto no depende del cursor en pantallas táctiles. La protección contra los ejemplos vive en
// content/proyectos.ts.
interface Props {
  etiqueta: string;
  titulo: string;
  foto: FotoDatos;
  items: Proyecto[];
  boton: { etiqueta: string; href: string };
}
const { etiqueta, titulo, foto, items, boton } = Astro.props;
// Copias de la fila para el ciclo continuo: la antes, la real y las que hagan falta para que, al avanzar un ciclo, aún
// quede fila a la derecha en la pantalla más ancha (el contenedor mide 1240 px como máximo).
const ancho = Math.max(items.length, 1) * (278 + 20);
const copias = 2 + Math.ceil(1240 / ancho);
---

<section class="team sobre-negro">
  <Foto class="team__bg" src={foto.src} alt="" sizes="100vw" />
  <div class="container team__inner" data-appear style="--appear-y:0px">
    <div class="team__head">
      <p class="t-caption2 c-blanco team__label" data-appear>
        {etiqueta}
      </p>
      <div class="team__text">
        <h2 class="t-h2 c-blanco" data-appear style="--appear-delay:0.1s">
          {titulo}
        </h2>
      </div>
    </div>
    <div
      class="ticker"
      role="region"
      aria-label="Proyectos"
      tabindex="0"
      data-ticker
      data-appear
      style="--appear-delay:0.3s"
    >
      <div class="ticker__track">
        {Array.from({ length: copias }, (_, copia) => (
          <div class="ticker__set" aria-hidden={copia !== 1 ? 'true' : undefined}>
            {items.map((p, i) => (
              <a
                class="member"
                href={boton.href}
                aria-label={`Ver proyectos: ${p.titulo}`}
                tabindex={copia !== 1 ? -1 : undefined}
              >
                <Foto
                  class="member__photo"
                  src={p.foto.src}
                  alt={copia === 1 ? p.foto.alt : ''}
                  sizes="278px"
                  widths={[278, 556, 834]}
                />
                <div class="member__blur" aria-hidden="true" />
                <div class="member__body">
                  <div class="member__name">
                    <p class="t-caption c-blanco">{String(i + 1).padStart(2, '0')}</p>
                    <h3 class="t-h4 c-blanco">{p.titulo}</h3>
                    <p class="t-caption c-blanco">{p.texto}</p>
                  </div>
                  <div class="member__meta">
                    <p class="t-caption c-blanco">{p.servicios.join(' · ')}</p>
                    <p class="t-caption c-blanco member__city">
                      <Icon name="pin" size="boton" />
                      {p.municipio}
                    </p>
                  </div>
                </div>
                {p.placeholder && <span class="member__ejemplo">EJEMPLO</span>}
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="team__boton" data-appear style="--appear-delay:0.4s">
      <Btn label={boton.etiqueta} href={boton.href} />
    </div>
    <script>
      // Hace avanzar la fila de proyectos y la deja deslizar a mano.
      const VELOCIDAD = 50; // px por segundo, como en la plantilla
      const ESPERA = 3000; // ms que el avance espera después de que la persona suelta
      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');

      document.querySelectorAll<HTMLElement>('[data-ticker]').forEach((fila) => {
        const copias = fila.querySelectorAll<HTMLElement>('.ticker__set');
        if (copias.length < 3) return;

        let ancho = 0; // ancho de una copia: lo que mide un ciclo completo
        let pos = 0;
        let hover = false;
        let foco = false;
        let tocando = false;
        let arrastrando = false;
        let visible = false;
        let reanudaEn = 0;
        let ultimo = 0;
        let raf = 0;
        let movido = 0;
        let inicioX = 0;
        let inicioScroll = 0;

        const esperar = () => (reanudaEn = performance.now() + ESPERA);
        const colocar = () => {
          // La copia real es la del medio: se empieza ahí y se puede ir a ambos lados sin llegar a un borde.
          ancho = copias[0].offsetWidth;
          fila.scrollLeft = ancho;
          pos = ancho;
        };
        // Saltar una copia a otra es invisible: son idénticas.
        const envolver = () => {
          const x = fila.scrollLeft;
          if (x >= 2 * ancho) fila.scrollLeft = x - ancho;
          else if (x <= 0) fila.scrollLeft = x + ancho;
        };

        const cuadro = (t: number) => {
          raf = requestAnimationFrame(cuadro);
          const dt = Math.min(t - ultimo, 100);
          ultimo = t;
          if (!ancho || !visible) return;
          if (hover || foco || tocando || arrastrando || t < reanudaEn) {
            pos = fila.scrollLeft; // la persona mueve la fila: el avance sigue desde donde quedó
            if (!tocando) envolver();
            return;
          }
          pos += (VELOCIDAD * dt) / 1000;
          if (pos >= 2 * ancho) pos -= ancho;
          fila.scrollLeft = pos;
        };

        const iniciar = () => {
          colocar();
          ultimo = performance.now();
          raf = requestAnimationFrame(cuadro);
        };
        const detener = () => {
          cancelAnimationFrame(raf);
          fila.scrollLeft = 0;
        };
        const aplicar = () => (reducido.matches ? detener() : iniciar());

        new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(fila);

        // Mientras la persona usa la fila, el avance se detiene.
        fila.addEventListener('mouseenter', () => (hover = true));
        fila.addEventListener('mouseleave', () => {
          hover = false;
          esperar();
        });
        fila.addEventListener('focusin', () => (foco = true));
        fila.addEventListener('focusout', () => {
          foco = false;
          esperar();
        });
        fila.addEventListener('touchstart', () => (tocando = true), { passive: true });
        const soltar = () => {
          tocando = false;
          esperar();
        };
        fila.addEventListener('touchend', soltar);
        fila.addEventListener('touchcancel', soltar);
        fila.addEventListener('wheel', esperar, { passive: true });
        fila.addEventListener('keydown', esperar);

        // Arrastre con el mouse (con el dedo, el navegador ya desliza solo).
        fila.addEventListener('pointerdown', (e) => {
          if (e.pointerType !== 'mouse' || e.button !== 0) return;
          arrastrando = true;
          movido = 0;
          inicioX = e.clientX;
          inicioScroll = fila.scrollLeft;
          fila.classList.add('is-arrastrando');
          const mover = (m: PointerEvent) => {
            const dx = m.clientX - inicioX;
            movido = Math.max(movido, Math.abs(dx));
            fila.scrollLeft = inicioScroll - dx;
            envolver();
            inicioScroll = fila.scrollLeft + dx;
          };
          const terminar = () => {
            arrastrando = false;
            fila.classList.remove('is-arrastrando');
            esperar();
            removeEventListener('pointermove', mover);
            removeEventListener('pointerup', terminar);
            removeEventListener('pointercancel', terminar);
          };
          addEventListener('pointermove', mover);
          addEventListener('pointerup', terminar);
          addEventListener('pointercancel', terminar);
        });
        // Si la persona arrastró, soltar no cuenta como clic en la tarjeta.
        fila.addEventListener(
          'click',
          (e) => {
            if (movido > 5) {
              e.preventDefault();
              e.stopPropagation();
            }
            movido = 0;
          },
          true,
        );
        fila.addEventListener('dragstart', (e) => e.preventDefault());

        addEventListener('resize', () => {
          if (!reducido.matches) colocar();
        });
        reducido.addEventListener('change', aplicar);
        aplicar();
      });
    </script>
  </div>
</section>
<style>
  .team {
    position: relative;
    overflow: clip;
    padding-block: 80px;
  }
  .team :global(.team__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .team__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
    overflow: hidden;
  }
  .team__head {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .team__label {
    flex: 1;
  }
  .team__text {
    width: 460px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* Contenedor con scroll horizontal nativo: avanza solo (script) y se desliza a mano. Sin barra visible. */
  .ticker {
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: 10px;
    cursor: grab;
    -webkit-user-select: none;
    user-select: none;
  }
  .ticker::-webkit-scrollbar {
    display: none;
  }
  .ticker.is-arrastrando {
    cursor: grabbing;
  }
  .ticker__track {
    display: flex;
    width: max-content;
  }
  .ticker__set {
    display: flex;
    gap: 20px;
    padding-right: 20px;
  }
  /* Movimiento reducido (o sin JavaScript): la fila no avanza sola, solo se desliza a mano, y se ocultan las copias. */
  @media (prefers-reduced-motion: reduce) {
    .ticker__set[aria-hidden='true'] {
      display: none;
    }
  }
  :global(html:not(.js)) .ticker__set[aria-hidden='true'] {
    display: none;
  }

  .member {
    position: relative;
    display: block;
    width: 278px;
    height: 352px;
    flex: none;
    border-radius: 8px;
    overflow: clip;
    border: 1px solid var(--dx-linea-sobre-foto);
    background: color-mix(in srgb, var(--dx-negro) 15%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit-user-drag: none;
  }
  .member :global(.member__photo),
  .member__blur {
    position: absolute;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .member :global(.member__photo) {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(var(--dx-brillo-sobre-foto));
  }
  .member__blur {
    inset: auto 0 0;
    height: 54px;
    background: color-mix(in srgb, var(--dx-negro) 15%, transparent);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
  .member:hover :global(.member__photo),
  .member:hover .member__blur,
  .member:focus-visible :global(.member__photo),
  .member:focus-visible .member__blur {
    opacity: 1;
  }
  .member__body {
    position: absolute;
    inset: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .member__name {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .member__meta {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .member__meta > :first-child {
    flex: 1;
  }
  .member__city {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .member__city :global(.icon) {
    width: 14px;
    height: 14px;
  }
  /* Etiqueta visible mientras el proyecto sea un ejemplo: amarillo sobre negro, el contraste de la marca. */
  .member__ejemplo {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--dx-amarillo);
    color: var(--dx-negro);
    font-family: var(--font-texto);
    font-size: var(--txt-chico);
    font-weight: 600;
    line-height: var(--lh-etiqueta);
  }
  .team__boton {
    display: flex;
  }
  /* Sin cursor que revele la foto (tablet, móvil o pantalla táctil), la foto se ve siempre. */
  @media (max-width: 1199.98px), (hover: none) {
    .member :global(.member__photo),
    .member__blur {
      opacity: 1;
    }
  }
  @media (max-width: 809.98px) {
    .team__head {
      flex-direction: column;
    }
    .team__text {
      width: 100%;
    }
  }
</style>
