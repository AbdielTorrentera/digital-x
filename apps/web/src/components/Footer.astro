---
import Logo from './Logo.astro';
import { negocio, telUrl, waUrl } from '../lib/negocio';
import { enlacesInformacion, gruposDeServicios } from '../lib/paginas';

// Pie de página (estructura sección 4, reglas-seo sección 4).
// Las columnas de servicios e información solo muestran páginas lanzadas y construidas.
// El texto de cobertura es fijo, en texto plano y sin enlaces por ciudad.
const anio = new Date().getFullYear();
---
<footer class="footer sobre-negro">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__marca">
        <a class="footer__logo" href="/"><Logo width={160} /></a>
        <p class="t-body-sm footer__cobertura">{negocio.textoCobertura}</p>
      </div>

      <div class="footer__cols">
        {gruposDeServicios.length > 0 && (
          <div class="footer__col">
            <p class="footer__titulo">Servicios</p>
            <ul>
              {gruposDeServicios.map((g) => (
                <li>
                  {g.hub
                    ? <a class="footer__enlace" href={g.hub.url}>{`Servicios de ${g.titulo.toLowerCase()}`}</a>
                    : g.servicios[0] && <a class="footer__enlace" href={g.servicios[0].url}>{g.servicios[0].titulo}</a>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {enlacesInformacion.length > 0 && (
          <div class="footer__col">
            <p class="footer__titulo">Información</p>
            <ul>
              {enlacesInformacion.map((p) => <li><a class="footer__enlace" href={p.url}>{p.titulo}</a></li>)}
            </ul>
          </div>
        )}

        <div class="footer__col">
          <p class="footer__titulo">Contacto</p>
          <ul>
            <li><a class="footer__enlace" href={telUrl}>{negocio.telefono.pantalla}</a></li>
            <li><a class="footer__enlace" href={waUrl()} target="_blank" rel="noopener">Escríbenos por WhatsApp</a></li>
            {negocio.correo && <li><a class="footer__enlace" href={`mailto:${negocio.correo}`}>{negocio.correo}</a></li>}
            {negocio.redes.map((r) => <li><a class="footer__enlace" href={r.url} target="_blank" rel="noopener">{r.nombre}</a></li>)}
          </ul>
        </div>
      </div>
    </div>

    <p class="t-caption footer__copy">© {anio} {negocio.nombre}</p>
  </div>
</footer>

<style>
  /* padding-bottom de 96 px: deja libre el final de la página para que el botón flotante de WhatsApp no tape texto. */
  /* .sobre-negro (tokens.css) pone fondo negro, texto blanco y texto secundario en gris medio. */
  .footer { padding: 40px 0 96px; }
  .footer__inner { display: flex; flex-direction: column; gap: 32px; }
  .footer__top { display: flex; flex-direction: column; gap: 32px; }
  .footer__marca { display: flex; flex-direction: column; gap: 12px; max-width: 360px; }
  .footer__logo { display: inline-flex; align-items: center; align-self: flex-start; min-height: 48px; color: var(--dx-blanco); }
  .footer__cobertura { line-height: 1.4; color: var(--texto-sec); }
  .footer__cols { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .footer__col ul { display: flex; flex-direction: column; }
  .footer__titulo { font-family: var(--font-titulos); font-size: var(--body); font-weight: 800; line-height: 1.2; color: var(--dx-blanco); margin-bottom: 4px; }
  .footer__enlace {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--body-sm);
    line-height: 1.2;
    color: var(--dx-blanco);
    transition: color 0.2s ease;
  }
  .footer__enlace:hover { color: var(--dx-amarillo); }
  .footer__copy { line-height: 1.4; color: var(--texto-sec); }

  @media (min-width: 810px) {
    .footer { padding-top: 56px; }
    .footer__top { flex-direction: row; justify-content: space-between; align-items: flex-start; gap: 48px; }
    .footer__cols { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 48px; }
    .footer__col { min-width: 180px; }
  }
</style>
