{
  "name": "marby-astro",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/descargar-contenido.ts --dev && astro dev",
    "build": "node scripts/descargar-contenido.ts && astro build",
    "preview": "astro preview",
    "check": "CONTENIDO_JSON=../../packages/sanity/muestra/contenido.json astro check",
    "test": "CONTENIDO_JSON=../../packages/sanity/muestra/contenido.json node --test \"src/**/*.test.mjs\"",
    "check:enlaces": "node scripts/revisar-enlaces.mjs",
    "contenido:descargar": "node scripts/descargar-contenido.ts",
    "contenido:muestra": "node scripts/descargar-contenido.ts --muestra"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@digitalx/sanity": "workspace:*",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.3.3",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "~6.0.3"
  }
}
