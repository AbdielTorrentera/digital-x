---
import logo from '../brand/digitalx-logo.svg?raw';

// Logo de Digital X (identidad sección 1): SVG en línea con fill="currentColor", así toma el color del
// contexto (negro sobre claro, blanco sobre negro). Proporción 1609:515 fija; ancho mínimo 120 px.
// role="img" + aria-label="Digital X" hace de alt. El <title> interno se quita para no duplicar el nombre.
interface Props { width?: number; class?: string }
const { width = 132, class: cls } = Astro.props;
const height = Math.round((width * 515) / 1609);
const svg = logo
  .replace(/<title>.*?<\/title>/, '')
  .replace(/ width="\d+" height="\d+"/, ` width="${width}" height="${height}" focusable="false"`);
---
<span class:list={['logo', cls]} style={`width:${width}px;height:${height}px`} set:html={svg} />
<style>
  .logo { display: inline-block; flex: none; line-height: 0; }
  .logo :global(svg) { display: block; width: 100%; height: 100%; }
</style>
