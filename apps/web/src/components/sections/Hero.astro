---
import Foto from '../Foto.astro';
import Logo from '../Logo.astro';
import type { Foto as FotoDatos } from '../../content/inicio';

// Portada del Inicio. La foto es la imagen del LCP: carga de inmediato y con prioridad alta, y el texto no espera
// a ninguna animación de entrada (que depende de JavaScript). Sin video: [PENDIENTE: clip de portada].
// Llena exactamente la pantalla visible bajo la barra fija: la barra mide `--nav-alto` y está en el flujo, así que la
// portada mide 100 % del alto de la pantalla menos esa barra (y crece si su contenido es más alto, sin cortarlo).
// Un solo H1. La marca (logo blanco y lema) va del lado derecho en escritorio y arriba del H1 en móvil; el logo es
// decorativo (el accesible es el de la barra).
interface Props {
  titulo: string;
  foto: FotoDatos;
  marca?: { lema: string };
}
const { titulo, foto, marca } = Astro.props;
---

<section class="hero sobre-negro">
  <Foto class="hero__img" src={foto.src} alt={foto.alt} sizes="100vw" prioritaria />
  <div class="scrim" aria-hidden="true"></div>
  <div class="container hero__inner">
    <h1 class="hero__title">{titulo}</h1>
    {marca && (
      <div class="hero__marca">
        <div class="hero__logo" aria-hidden="true">
          <Logo />
        </div>
        <p class="hero__lema t-body-sm c-blanco">{marca.lema}</p>
      </div>
    )}
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--nav-alto));
    min-height: calc(100dvh - var(--nav-alto));
    overflow: clip;
    display: flex;
    align-items: stretch;
  }
  /* Picture no le pone al <img> el atributo de alcance de Astro: se selecciona como global dentro de la sección. */
  .hero :global(.hero__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--dx-negro);
  }
  /* Móvil: la marca arriba y el H1 abajo. */
  .hero__inner {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--esp-6);
    padding-block: var(--esp-6) var(--esp-7);
  }
  .hero__marca {
    order: -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-2);
  }
  .hero__logo {
    --logo-ancho: 144px;
    color: var(--dx-blanco);
  }
  .hero__title {
    font-family: var(--font-titulos);
    font-size: var(--txt-display);
    font-weight: 800;
    line-height: var(--lh-titulo);
    letter-spacing: var(--ls-titulo);
    color: var(--dx-blanco);
    text-wrap: balance;
  }
  /* Escritorio y tableta: el H1 a la izquierda y la marca a la derecha, alineados abajo. */
  @media (min-width: 768px) {
    .hero__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--esp-7);
      /* Abajo, lo que ocupa el botón flotante de WhatsApp (56 px + su margen): la marca nunca queda tapada. */
      padding-block: var(--esp-8) var(--esp-9);
    }
    .hero__title {
      max-width: 18ch;
    }
    .hero__marca {
      order: 0;
      align-items: flex-end;
      text-align: right;
    }
    .hero__logo {
      --logo-ancho: 240px;
    }
  }
  @media (min-width: 1024px) {
    .hero__inner {
      padding-block: var(--esp-9);
    }
  }
</style>
