---
import logo from '../brand/digitalx-logo.svg?raw';

// Logo de Digital X (identidad sección 1): SVG en línea con fill="currentColor", así toma el color del
// contexto (negro sobre claro, blanco sobre negro). El ancho sale de --logo-ancho (≥ 120 px) y la proporción
// 1609:515 es fija.
// role="img" + aria-label="Digital X" hace de alt. El <title> interno se quita para no duplicar el nombre.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const svg = logo.replace(/<title>.*?<\/title>/, '').replace(/ width="\d+" height="\d+"/, ' focusable="false"');
---

<span class:list={['logo', cls]} set:html={svg} />
<style>
  .logo {
    display: inline-block;
    flex: none;
    width: var(--logo-ancho);
    aspect-ratio: 1609 / 515;
    line-height: 0;
  }
  .logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
