---
import Btn from '../Btn.astro';
import QuestionRow from '../ui/QuestionRow.astro';
import { site } from '../../lib/site';
interface Props {
  set?: 'general' | 'property';
  imageAlt?: string;
}
const { set = 'general', imageAlt } = Astro.props;
const faq = await site('faq');
const items = faq[set];
---

<section class="faq">
  <div class="container faq__inner">
    <div class="faq__head">
      <div class="faq__title">
        <p class="t-caption2" data-appear>
          {faq.label}
        </p>
        <h2 class="t-h2" data-appear>
          {faq.title}
        </h2>
      </div>
      <div class="faq__side">
        <p class="t-body" data-appear>
          {faq.text}
        </p>
        <div data-appear>
          <Btn label={faq.cta.label} href={faq.cta.href} />
        </div>
      </div>
    </div>
    <div class="faq__body">
      <div class="faq__list" data-accordion>
        {items.map((it: any, i: number) => (
          <QuestionRow n={i + 1} q={it.q} a={it.a} />
        ))}
      </div>
      <div class="faq__media" data-appear>
        <img class="faq__img" src={faq.image} alt={imageAlt ?? faq.imageAlt} loading="lazy" />
      </div>
    </div>
  </div>
</section>
<style>
  .faq {
    background: var(--dx-blanco);
    padding-block: var(--esp-8);
  }
  .faq__inner {
    display: flex;
    flex-direction: column;
    gap: var(--esp-7);
  }
  .faq__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-5);
  }
  .faq__title {
    display: flex;
    flex-direction: column;
    gap: var(--esp-3);
  }
  .faq__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--esp-4);
  }
  .faq__body {
    display: flex;
    align-items: flex-start;
    gap: var(--esp-7);
  }
  .faq__list {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--esp-5);
  }
  .faq__media {
    display: none;
  }
  .faq__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radio);
  }
  @media (min-width: 1024px) {
    .faq {
      padding-block: var(--esp-9);
    }
    .faq__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .faq__title,
    .faq__side {
      flex: 1 1 0;
    }
    .faq__media {
      display: block;
      flex: 1 1 0;
      min-width: 0;
    }
  }
</style>
